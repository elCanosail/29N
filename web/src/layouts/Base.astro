---
/**
 * Base — layout de las tres páginas (DESIGN.md §1, §3, §7).
 * Carga tipográfica: Newsreader (variable, opsz) + Source Sans 3 + IBM Plex Mono.
 */
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
// Solo subconjunto `latin` (incluye el suplemento latin-1: á é í ó ú ñ ü ¿ ¡).
// Evita enviar cyrillic/vietnamese, que este sitio en español nunca usa.
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  ogImage?: string;
  /** Objetos JSON-LD que declara la página (organización, migas, dataset…). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Fuera de los buscadores (p. ej. 404). */
  noindex?: boolean;
  tipoOg?: 'website' | 'article' | 'profile';
}
const {
  titulo,
  descripcion = 'Histórico de encuestas electorales españolas, resultados oficiales 1977–2023 y predicción provincial con intervalos.',
  ogImage,
  jsonLd,
  noindex = false,
  tipoOg = 'website',
} = Astro.props as Props;

// La marca no se repite: si el título ya dice 29N, no se le añade otra vez.
const tituloCompleto =
  titulo === 'Portada'
    ? '29N, estimación de resultados'
    : /29N\s*$/.test(titulo)
      ? titulo
      : `${titulo} · 29N`;
// Autocanónica: cada página declara su URL absoluta, con la barra final que
// sirve el sitio. Sin esto Google elige por su cuenta entre /x y /x/.
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogAbsoluta = ogImage
  ? new URL(ogImage, Astro.site ?? Astro.url).toString()
  : new URL('/og/portada.png', Astro.site ?? Astro.url).toString();
const bloques = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content={tipoOg} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="29N" />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogAbsoluta} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogAbsoluta} />
    {bloques.map((b) => (
      <script type="application/ld+json" set:html={JSON.stringify(b)} />
    ))}
  </head>
  <body>
    <a class="salto-contenido" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
