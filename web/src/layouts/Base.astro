---
/**
 * Base — layout de las tres páginas (DESIGN.md §1, §3, §7).
 * Carga tipográfica: Newsreader (variable, opsz) + Source Sans 3 + IBM Plex Mono.
 */
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
// Solo subconjunto `latin` (incluye el suplemento latin-1: á é í ó ú ñ ü ¿ ¡).
// Evita enviar cyrillic/vietnamese, que este sitio en español nunca usa.
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descripcion?: string;
}
const {
  titulo,
  descripcion = 'Histórico de encuestas electorales españolas, resultados oficiales 1977–2023 y predicción provincial con intervalos.',
} = Astro.props as Props;

const tituloCompleto = titulo === 'Portada' ? '29N, estimación de resultados' : `${titulo} · 29N`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
  </head>
  <body>
    <a class="salto-contenido" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
