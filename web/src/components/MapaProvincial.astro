---
/**
 * MapaProvincial — cartograma de provincias (DESIGN.md §4 «Mapa provincial»).
 *
 * No se dibuja una silueta geográfica (no disponemos de la geometría provincial
 * en el repo y falsearla sería deshonesto): se dibuja un CARTAGRAMA, una celda
 * por provincia colocada aproximadamente según su posición real. Cada celda
 * enlaza con el panel de su provincia (`#prov-<código>`), de modo que el mapa
 * queda sincronizado con el panel y con la tabla paralela sin JavaScript.
 *
 * El color codifica el grupo del partido con más escaños esperados, pero NUNCA
 * es el único canal: cada celda escribe su sigla. El mapa no es el único camino
 * al dato (DESIGN.md §7.3): hay tabla paralela con las mismas cifras.
 */
import { colorPartido, sigla } from '../lib/partidos';

interface ProvinciaMapa {
  codigo: number;
  nombre: string;
  escanos: number;
  ganador: string;
}

interface Props {
  provincias: ProvinciaMapa[];
  descripcion?: string;
}
const { provincias, descripcion } = Astro.props as Props;

// Cartograma 11 × 9. Cada código ocupa (columna, fila) según su posición real.
const LAYOUT: Record<number, [number, number]> = {
  15: [2, 1], 27: [3, 1], 33: [4, 1], 39: [5, 1], 48: [6, 1], 20: [7, 1], 1: [8, 1], 31: [9, 1], 17: [11, 1],
  36: [1, 2], 32: [2, 2], 24: [3, 2], 34: [4, 2], 9: [5, 2], 42: [6, 2], 26: [7, 2], 50: [8, 2], 22: [9, 2], 25: [10, 2], 8: [11, 2],
  37: [2, 3], 49: [3, 3], 47: [4, 3], 40: [5, 3], 19: [6, 3], 44: [9, 3], 43: [10, 3],
  10: [1, 4], 6: [2, 4], 5: [4, 4], 28: [6, 4], 16: [7, 4], 13: [8, 4], 12: [9, 4], 46: [10, 4],
  21: [1, 5], 41: [2, 5], 14: [3, 5], 23: [4, 5], 45: [5, 5], 2: [6, 5], 3: [8, 5], 30: [9, 5], 7: [11, 5],
  11: [2, 6], 29: [3, 6], 18: [4, 6], 4: [5, 6],
  35: [1, 8], 51: [10, 8], 52: [11, 8],
  38: [1, 9],
};

/** Abreviatura estable a partir del nombre oficial. */
function abrev(nombre: string): string {
  const trozo = nombre.split('/')[0].split(',')[0].trim();
  const palabras = trozo.split(/\s+/).filter((p) => p.length > 2);
  if (palabras.length >= 3) return palabras.slice(0, 3).map((p) => p[0]).join('').toUpperCase();
  if (palabras.length === 2) return (palabras[0].slice(0, 2) + palabras[1][0]).toUpperCase();
  return trozo.slice(0, 4).toUpperCase();
}

const filas = provincias.filter((p) => LAYOUT[p.codigo]);
const grupos = [...new Set(filas.map((p) => p.ganador))].sort();
---

<figure class="mapa">
  <div class="mapa__marco">
  <div class="mapa__rejilla" role="group" aria-label={descripcion ?? 'Cartograma de provincias'}>
    {filas.map((p) => {
      const [col, row] = LAYOUT[p.codigo];
      return (
        <a
          class="celda"
          href={`#prov-${p.codigo}`}
          data-prov={p.codigo}
          data-c={colorPartido(p.ganador)}
          data-gan={sigla(p.ganador)}
          style={`grid-column:${col};grid-row:${row};--c:${colorPartido(p.ganador)}`}
          aria-label={`${p.nombre}: ${p.ganador}, ${p.escanos} escaños en juego`}
        >
          <span class="celda__abrev">{abrev(p.nombre)}</span>
          <span class="celda__gan mono">{sigla(p.ganador)}</span>
        </a>
      );
    })}
  </div>
  </div>

  <figcaption class="mapa__pie">
    <p class="eyebrow">Partido con más escaños esperados</p>
    <ul class="mapa__leyenda">
      {grupos.map((g) => (
        <li>
          <span class="mapa__muestra" style={`background:${colorPartido(g)}`} aria-hidden="true"></span>
          <span>{g}</span>
        </li>
      ))}
    </ul>
    <p class="nota">
      Cartograma: cada celda es una provincia, colocada según su posición real. El color
      indica el partido con <strong>más escaños esperados</strong> (media de 10 000
      simulaciones); la sigla va escrita para que el color no sea el único canal.
      La geometría provincial fina es una mejora pendiente, no un dato.
    </p>
  </figcaption>
</figure>

<style>
  .mapa { margin: 0; min-width: 0; }
  .mapa__marco { overflow-x: auto; min-width: 0; -webkit-overflow-scrolling: touch; }
  .mapa__rejilla {
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    gap: 3px;
  }
  .celda {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    aspect-ratio: 1 / 0.95;
    padding: 1px;
    border-radius: 2px;
    text-decoration: none;
    color: var(--tinta);
    background: color-mix(in oklch, var(--c) 18%, var(--papel));
    border: 1px solid color-mix(in oklch, var(--c) 45%, var(--papel));
    overflow: hidden;
  }
  .celda:hover { outline: 2px solid var(--tinta); }
  .celda:focus-visible { outline: 3px solid var(--foco); outline-offset: 1px; }
  .celda__abrev { font-size: 0.62rem; font-weight: 700; line-height: 1; letter-spacing: -0.02em; }
  .celda__gan { font-size: 0.56rem; color: var(--tinta-2); line-height: 1.1; }

  .mapa__pie { margin-top: var(--s-3); }
  .mapa__leyenda {
    list-style: none;
    margin: 0 0 var(--s-2);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    font-size: 0.8125rem;
    color: var(--tinta-2);
  }
  .mapa__leyenda li { display: inline-flex; align-items: center; gap: var(--s-2); }
  .mapa__muestra { inline-size: 14px; block-size: 14px; border-radius: 2px; }

  @media (max-width: 560px) {
    .mapa__rejilla { min-width: 500px; }
    .celda__abrev { font-size: 0.6rem; }
    .celda__gan { display: none; }
  }
</style>
