---
/**
 * BarraEscanos — el gráfico clásico de reparto de escaños (DESIGN.md §5).
 *
 * Dos barras apiladas comparables: la estimación 29N junto al resultado real
 * de la elección anterior. Cada segmento es un partido; su ancho, los escaños.
 * Mismo orden y mismos colores en ambas barras para que la comparación sea
 * inmediata.
 *
 * Cada segmento muestra su ficha al pasar el puntero (CSS :hover, sin
 * JavaScript); la leyenda lleva siempre escaños Y porcentaje de voto de ambas
 * elecciones. Mobile-first: barras flex a ancho completo; la leyenda envuelve.
 *
 * Accesibilidad: el bloque es role="img" con la conclusión en el aria-label;
 * la leyenda es texto plano con los mismos números (los tooltips son una
 * mejora de puntero, no el único camino).
 */
import { num, entero } from '../lib/format';
import { colorPartido, sigla, sigla29N } from '../lib/partidos';

export interface FilaReparto {
  /** etiqueta visible del 29N (puede diferir de la clave histórica). */
  partido: string;
  /** clave de datos del modelo (SUMAR), para color y orden. */
  clave?: string;
  /** escaños estimados 29N (media de la simulación) */
  estimacionEscanos: number;
  /** % de voto estimado 29N (serie ponderada, sobre votos válidos) */
  estimacionPct: number;
  /** escaños reales de la elección de comparación */
  realEscanos: number;
  /** % de voto real de la elección de comparación (sobre votos válidos) */
  realPct: number;
}

interface Props {
  filas: FilaReparto[];
  fechaObjetivo?: string;
  fechaReal?: string;
  descripcion: string;
  pie?: string;
  lectura?: string;
}

const {
  filas,
  fechaObjetivo = '29-11-2026',
  fechaReal = '23-07-2023',
  descripcion,
  pie,
  lectura,
} = Astro.props as Props;

const clave = (f: FilaReparto) => f.clave ?? f.partido;
const orden = [...filas].sort((a, b) => b.estimacionEscanos - a.estimacionEscanos);
// Orden editorial (Chema, 16-oct): en la estimación VOX va segundo — es probable
// que se sume al bloque del PP para alcanzar la mayoría absoluta. Las dos barras
// comparten orden para que la comparación sea directa.
const vox = orden.find((f) => clave(f) === 'VOX');
const orden29n = orden.filter((f) => clave(f) !== 'VOX');
if (vox) orden29n.splice(1, 0, vox);
// En el 23J real, el bloque de gobierno va unido a la izquierda pero con cada
// partido independiente (Chema, 16-oct): PSOE primero y después los socios del
// acuerdo de investidura; el resto sigue el orden de la estimación.
const MIEMBROS_BLOQUE = ['PSOE', 'SUMAR', 'ERC', 'EH BILDU', 'PNV', 'BNG', 'CC'];
const esBloque = (p: string) => MIEMBROS_BLOQUE.includes(p);
const orden23j = [
  ...MIEMBROS_BLOQUE
    .map((p) => orden.find((f) => clave(f) === p))
    .filter((f): f is (typeof orden)[number] => Boolean(f)),
  ...orden29n.filter((f) => !esBloque(clave(f))),
];
const delta = (f: (typeof orden)[number]) => f.estimacionEscanos - f.realEscanos;
const conDelta = orden.some((f) => Math.abs(delta(f)) > 0.05);
const anchoPct = (v: number) => (v / 350) * 100;
const TEXTO_TINTA: Record<string, boolean> = { ERC: true, JXCAT: true, BNG: true, CUP: true, PACMA: true };
const flecha = (v: number) => (v > 0.05 ? '▲' : v < -0.05 ? '▼' : '＝');
const clase = (v: number) => (v > 0.05 ? 'sube' : v < -0.05 ? 'baja' : 'plano');
const signado = (v: number) => (v > 0 ? `+${num(v, 1)}` : num(v, 1));
---

<figure class="reparto">
  <div class="reparto__cuerpo" role="img" aria-label={descripcion}>
    <p class="reparto__rotulo">
      <span class="reparto__eleccion mono">29N</span>
      <span>estimación del modelo</span>
      <span class="reparto__fecha mono">{fechaObjetivo}</span>
    </p>
    <div class="reparto__barra-marco">
      <div class="reparto__barra" aria-hidden="true">
        {orden29n.filter((f) => f.estimacionEscanos > 0).map((f) => (
          <span
            class="reparto__tramo"
            style={`flex:${Math.max(f.estimacionEscanos, 0.001)};background:${colorPartido(clave(f))}`}
          >
            {anchoPct(f.estimacionEscanos) >= 8.5 && (
              <span class={`reparto__tramo__texto ${TEXTO_TINTA[clave(f)] ? 'reparto__tramo__texto--tinta' : ''}`}>{sigla29N(clave(f))}</span>
            )}
            {anchoPct(f.estimacionEscanos) >= 9 && (
              <span class={`reparto__tramo__texto reparto__tramo__num ${TEXTO_TINTA[clave(f)] ? 'reparto__tramo__texto--tinta' : ''}`}>{entero(f.estimacionEscanos)}</span>
            )}
            <span class="reparto__tip mono">
              <strong>{f.partido}</strong> · 29N: {num(f.estimacionEscanos, 1)} escaños ({num(f.estimacionPct, 1)} %)
            </span>
          </span>
        ))}
      </div>
      <span class="reparto__mayoria" aria-hidden="true"></span>
    </div>

    <p class="reparto__rotulo reparto__rotulo--segundo">
      <span class="reparto__eleccion mono">23J</span>
      <span>resultado real</span>
      <span class="reparto__fecha mono">{fechaReal}</span>
    </p>
    <div class="reparto__barra-marco">
      <div class="reparto__barra" aria-hidden="true">
        {orden23j.filter((f) => f.realEscanos > 0).map((f) => (
          <span
            class="reparto__tramo"
            style={`flex:${Math.max(f.realEscanos, 0.001)};background:${colorPartido(clave(f))}`}
          >
            {anchoPct(f.realEscanos) >= 8.5 && (
              <span class={`reparto__tramo__texto ${TEXTO_TINTA[clave(f)] ? 'reparto__tramo__texto--tinta' : ''}`}>{sigla(clave(f))}</span>
            )}
            {anchoPct(f.realEscanos) >= 9 && (
              <span class={`reparto__tramo__texto reparto__tramo__num ${TEXTO_TINTA[clave(f)] ? 'reparto__tramo__texto--tinta' : ''}`}>{entero(f.realEscanos)}</span>
            )}
            <span class="reparto__tip mono">
              <strong>{clave(f)}</strong> · 23J: {entero(f.realEscanos)} escaños ({num(f.realPct, 1)} %)
            </span>
          </span>
        ))}
      </div>
      <span class="reparto__mayoria" aria-hidden="true"></span>
      <span class="reparto__mayoria__etiqueta mono" aria-hidden="true">mayoría absoluta · 176</span>
    </div>
  </div>

  <div class="reparto__comparativa">
    <div class="reparto__fila reparto__fila--cabecera" aria-hidden="true">
      <span class="reparto__col reparto__col--partido">Partido</span>
      <span class="reparto__col">Esc. 29N</span>
      <span class="reparto__col">Esc. 23J</span>
      <span class="reparto__col">Δ esc.</span>
      <span class="reparto__col">% 29N</span>
      <span class="reparto__col">% 23J</span>
    </div>
    {orden.map((f) => (
      <div class="reparto__fila">
        <span class="reparto__col reparto__col--partido">
          <span class="reparto__muestra" style={`background:${colorPartido(clave(f))}`} aria-hidden="true"></span>
          {f.partido}
        </span>
        <span class="reparto__col mono reparto__num">{num(f.estimacionEscanos, 1)}</span>
        <span class="reparto__col mono reparto__num">{entero(f.realEscanos)}</span>
        <span class="reparto__col mono reparto__num">
          {conDelta && <span class={`reparto__delta ${clase(delta(f))}`}>{flecha(delta(f))} {signado(delta(f))}</span>}
        </span>
        <span class="reparto__col mono reparto__num">{num(f.estimacionPct, 1)}</span>
        <span class="reparto__col mono reparto__num">{num(f.realPct, 1)}</span>
      </div>
    ))}
  </div>

  {pie && <p class="reparto__pie mono">{pie}</p>}
  {lectura && <p class="reparto__lectura">{lectura}</p>}
</figure>

<style>
  .reparto {
    margin: 0 0 var(--s-5);
    background: var(--papel);
    border-top: var(--borde-regla);
    border-bottom: var(--borde-regla);
    padding: var(--s-4) 0;
  }

  .reparto__rotulo {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    margin: 0 0 var(--s-1);
    font-size: var(--t-small);
    color: var(--tinta-2);
  }
  .reparto__rotulo--segundo { margin-top: var(--s-5); }
  .reparto__eleccion { font-weight: 700; font-size: 1rem; color: var(--tinta); }
  .reparto__fecha { margin-left: auto; color: var(--tinta-3); }

  .reparto__barra-marco { position: relative; }
  .reparto__barra {
    display: flex;
    width: 100%;
    height: 56px;
    border: 1px solid var(--tinta);
  }
  .reparto__mayoria {
    position: absolute;
    top: -5px;
    bottom: -5px;
    left: 50.29%;
    width: 2px;
    background: var(--tinta);
  }
  .reparto__mayoria__etiqueta {
    position: absolute;
    bottom: -17px;
    left: 50.29%;
    transform: translateX(-50%);
    font-size: 0.65rem;
    color: var(--tinta-2);
    white-space: nowrap;
  }
  .reparto__tramo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-width: 2px;
    overflow: hidden;
  }
  .reparto__tramo + .reparto__tramo { border-left: 2px solid var(--papel); }
  .reparto__tramo__texto {
    color: var(--papel);
    font-family: var(--f-mono);
    font-size: 0.62rem;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .reparto__tramo__texto--tinta { color: var(--tinta); }
  .reparto__tramo__num { font-size: 0.7rem; font-weight: 600; }

  /* Ficha al pasar el puntero: CSS puro, sin JavaScript.
     display:none fuera de hover: un tooltip invisible NO puede ensanchar
     el layout móvil (lección 15-10-2026: opacity:0 desbordaba la página). */
  .reparto__tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    display: none;
    background: var(--tinta);
    color: var(--papel);
    padding: 6px 10px;
    border-radius: 3px;
    font-size: 0.75rem;
    line-height: 1.5;
    white-space: nowrap;
    z-index: 6;
  }
  .reparto__tip strong { color: var(--papel); }
  .reparto__tramo:hover .reparto__tip,
  .reparto__tramo:focus-visible .reparto__tip { display: block; }
  .reparto__tramo:first-child .reparto__tip { left: 0; transform: none; }
  /* los últimos tramos anclan la ficha a la derecha: sin desbordamiento */
  .reparto__tramo:nth-last-child(-n+3) .reparto__tip { left: auto; right: 0; transform: none; }

  .reparto__comparativa {
    margin: var(--s-4) 0 0;
    border-top: var(--borde-regla);
  }
  .reparto__fila {
    display: grid;
    grid-template-columns: minmax(72px, 1.3fr) repeat(5, minmax(46px, 0.65fr));
    gap: var(--s-1) var(--s-2);
    align-items: baseline;
    padding: var(--s-1) 0;
    border-bottom: var(--borde-regla);
  }
  .reparto__fila--cabecera {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tinta-2);
    border-bottom: var(--borde-tinta);
  }
  .reparto__col--partido {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 600;
    min-width: 0;
  }
  .reparto__fila--cabecera .reparto__col { text-align: right; }
  .reparto__fila--cabecera .reparto__col--partido { text-align: left; }
  .reparto__num { text-align: right; }
  .reparto__muestra {
    inline-size: 12px;
    block-size: 12px;
    border-radius: 2px;
    flex: 0 0 auto;
  }
  .reparto__delta.sube { color: var(--ok); }
  .reparto__delta.baja { color: var(--alerta); }
  .reparto__delta.plano { color: var(--tinta-3); }

  .reparto__pie { margin: var(--s-3) 0 0; color: var(--tinta-2); font-size: 0.8125rem; }
  .reparto__lectura {
    margin: var(--s-2) 0 0;
    max-width: var(--medida);
    font-size: var(--t-small);
    line-height: var(--lh-small);
    color: var(--tinta-2);
  }
</style>
