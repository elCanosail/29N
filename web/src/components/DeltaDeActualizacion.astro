---
/**
 * DeltaDeActualizacion — la fila mono que dice cuándo se corrió el modelo y
 * cuánto se movió el escenario central desde la corrida anterior.
 * Issue #15 › PR-3 (componente 2, «HeroBar v2 + DeltaDeActualización»).
 *
 * Fuente: `seats.json.meta.generado`, `meta.n_runs` y `deltas{contra, nacional}`.
 * Todo se calcula en build: la fecha es la misma en portada y en /prediccion/
 * (si difieren, el build falla; ver `scripts/test-hero.mjs`).
 *
 * Honestidad de frescura: si el dato tiene más de 7 días, la fila se pinta en
 * ámbar y dice «Corrida pendiente» en vez de fingir que está al día.
 */
import { entero } from '../lib/format';
import { nombre29N } from '../lib/partidos';

interface Props {
  /** Fecha de la corrida del modelo (ISO, `meta.generado`). */
  generado: string;
  /** Número de simulaciones D'Hondt (`meta.n_runs`). */
  nRuns: number;
  /** Escaños de diferencia por partido frente a la corrida anterior. */
  deltas?: Record<string, number>;
  /** Fecha de la corrida con la que se compara (`deltas.contra`). */
  contra?: string | null;
}

const { generado, nRuns, deltas = {}, contra } = Astro.props as Props;

const fecha = generado.split('-').reverse().join('-');
const dias = Math.max(0, Math.floor((Date.now() - Date.parse(`${generado}T00:00:00Z`)) / 86400000));
const caducado = dias > 7;
const cuando = dias === 0 ? 'hoy' : dias === 1 ? 'ayer' : `hace ${dias} días`;

// Solo partidos que de verdad se mueven, de mayor a menor movimiento. Seis como
// máximo: la fila es una señal, no un recuento (el detalle completo está en la
// tabla). Los empates se resuelven por orden alfabético para que el build sea
// determinista.
const movimientos = Object.entries(deltas)
  .filter(([, v]) => Number.isFinite(v) && Math.abs(v) >= 0.5)
  .sort((a, b) => Math.abs(b[1]) - Math.abs(a[1]) || a[0].localeCompare(b[0]))
  .slice(0, 6)
  .map(([partido, v]) => {
    const valor = Math.round(v);
    const etiqueta = nombre29N(partido);
    return {
      partido: etiqueta,
      valor,
      flecha: valor > 0 ? '▲' : '▼',
      texto: `${etiqueta} ${valor > 0 ? 'sube' : 'baja'} ${entero(Math.abs(valor))} escaño${Math.abs(valor) === 1 ? '' : 's'} desde la corrida anterior`,
    };
  });

const clases = ['delta-actualizacion', 'mono'];
if (caducado) clases.push('delta-actualizacion--caducado');
---

<p
  class={clases.join(' ')}
  data-actualizado={generado}
  data-contra={contra ?? undefined}
  data-dias={dias}
>
  <span class="delta-actualizacion__fecha">Actualizado {fecha} <span class="delta-actualizacion__cuando">({cuando})</span></span>
  <span class="delta-actualizacion__sep" aria-hidden="true">·</span>
  <span>{entero(nRuns)} simulaciones</span>
  {caducado ? (
    <>
      <span class="delta-actualizacion__sep" aria-hidden="true">·</span>
      <span class="delta-actualizacion__aviso">Corrida pendiente</span>
    </>
  ) : (
    movimientos.length > 0 && (
      <>
        <span class="delta-actualizacion__sep" aria-hidden="true">·</span>
        <span class="delta-actualizacion__movs">
          {movimientos.map((m, i) => (
            <>
              {i > 0 && <span class="delta-actualizacion__sep" aria-hidden="true"> · </span>}
              <span class="delta-actualizacion__mov" data-delta={m.valor} aria-label={m.texto}>
                <span aria-hidden="true">{m.partido} {m.flecha}{entero(Math.abs(m.valor))}</span>
              </span>
            </>
          ))}
        </span>
      </>
    )
  )}
</p>

<style>
  .delta-actualizacion {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s-2);
    margin: var(--s-3) 0 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--tinta-2);
  }
  .delta-actualizacion__fecha { color: var(--tinta); }
  .delta-actualizacion__cuando { color: var(--tinta-3); }
  .delta-actualizacion__sep { color: var(--tinta-3); }
  .delta-actualizacion__movs { color: var(--tinta); }
  .delta-actualizacion__mov { white-space: nowrap; }
  /* Frescura caducada: ámbar de incertidumbre, nunca verde de «todo bien». */
  .delta-actualizacion--caducado { color: var(--intervalo-texto); }
  .delta-actualizacion--caducado .delta-actualizacion__fecha,
  .delta-actualizacion--caducado .delta-actualizacion__movs { color: var(--intervalo-texto); }
  .delta-actualizacion__aviso { font-weight: 600; }
</style>
