---
/**
 * HeroBar v2 — los 350 escaños del 29N con la incertidumbre encima.
 * Issue #15 › PR-3 (componente 2: «HeroBar v2 + DeltaDeActualización»).
 *
 * Qué cambia frente a `BarraEscanos`: pinta el **escenario central**
 * (`central_escenario`, que suma exactamente 350) en vez de la media, añade la
 * capa de **ticks IC95** en ámbar bajo cada partido con 5 escaños o más, deja
 * las etiquetas solo en los segmentos anchos (≥ 10 escaños) y manda a los
 * menores a una leyenda compacta. La comparación con el 23J no se duplica aquí:
 * sigue viviendo en `BarraEscanos`.
 *
 * Reglas que el componente no se salta:
 *  - Los escaños son enteros. Nunca decimales en la barra.
 *  - El tooltip siempre da rango (central + IC95 + 23J), nunca un número solo.
 *  - Un tick por partido y carril propio cuando los intervalos se solapan: en
 *    una sola línea, PP y PSOE se pisan y el gráfico miente por omisión.
 *  - `role="img"` con el reparto verbalizado; la tabla de datos es la de
 *    `HorquillasEscanos` (misma página), no una copia nueva.
 */
import { entero } from '../lib/format';
import { colorPartido, sigla29N } from '../lib/partidos';
import DeltaDeActualizacion from './DeltaDeActualizacion.astro';

export interface FilaHero {
  /** Clave de datos del modelo (SUMAR), para color y orden. */
  partido: string;
  /** Etiqueta visible del 29N (Frente A para SUMAR). */
  etiqueta: string;
  /** `central_escenario`: la partida que suma 350. */
  central: number;
  /** Media de las 10.000 simulaciones (solo para la leyenda). */
  media: number;
  /** Extremos del IC95 de escaños. */
  min: number;
  max: number;
  /** Escaños reales del 23J, para el tooltip y la leyenda. */
  esc23: number;
  /** Diferencia de escenario central frente a la corrida anterior. */
  delta: number | null;
}

interface Props {
  filas: FilaHero[];
  /** `seats.json.meta.generado` */
  generado: string;
  /** `seats.json.meta.n_runs` */
  nRuns: number;
  deltas?: Record<string, number>;
  contra?: string | null;
  /** `aria-label` del gráfico: el reparto verbalizado, no «gráfico de barras». */
  descripcion: string;
  pie?: string;
  lectura?: string;
}

const { filas, generado, nRuns, deltas = {}, contra, descripcion, pie, lectura } = Astro.props as Props;

const TOTAL = 350;
const MAYORIA = 176;

// Orden editorial del sitio (DESIGN.md §Home): por escaños, con VOX en segundo
// lugar por su suma con el PP. Mismo criterio que BarraEscanos para que las dos
// barras de la portada se lean igual.
const orden = [...filas].sort((a, b) => b.central - a.central || a.partido.localeCompare(b.partido));
const iVox = orden.findIndex((f) => f.partido === 'VOX');
if (iVox > 1) orden.splice(1, 0, orden.splice(iVox, 1)[0]);

const conEscanos = orden.filter((f) => f.central > 0);
let acumulado = 0;
const tramos = conEscanos.map((f) => {
  const inicio = acumulado;
  acumulado += f.central;
  return { ...f, inicio, ancho: f.central };
});
// Fila de tick: 14 px (4 px de línea + aire para el rótulo al lado). Siete
// filas son 98 px, menos que la barra y su eje juntos.
const ALTO_CARRIL = 14;
const sumaCentral = tramos.reduce((acc, f) => acc + f.central, 0);
// Si algún día el escenario central no sumara 350, se dice en voz alta en vez
// de dibujar una barra que parece completa sin serlo (criterio 2.4 del PR-3).
const sumaRara = Math.abs(sumaCentral - TOTAL) > 0.5;

// Etiquetas dentro del segmento solo donde caben de verdad (≥ 10 escaños).
const MIN_ETIQUETA = 10;
// Ticks IC95 solo con presencia real en el Congreso (≥ 5 escaños).
const MIN_TICK = 5;
const leyendaMenores = orden.filter((f) => f.central > 0 && f.central < MIN_ETIQUETA);

// Un tick por partido y fila propia, en el orden editorial. Probado antes con
// carriles compartidos (coloración voraz): los intervalos de SUMAR (0–50) y los
// de ERC/EH/JXCAT caben en cuatro filas, pero el lector no sabe de quién es cada
// raya. Con una fila por partido y su rótulo al lado, la capa se lee sola.
const ticks = orden.filter((f) => f.central >= MIN_TICK);

// Versión móvil: columnas verticales para los partidos con tick, en el mismo
// orden editorial. El eje es 0–180 (no 0–350): en 390 px, 350 escaños dejan las
// barras en un tercio de la altura y la lectura se pierde. Con 180 la línea de
// mayoría queda arriba y las columnas se comparan; la escala va rotulada.
const ALTURA_MOVIL = 150;
const TOPE_MOVIL = 180;
const columnas = orden.filter((f) => f.central >= MIN_TICK);

const pct = (v: number) => (v / TOTAL) * 100;
const TEXTO_TINTA: Record<string, boolean> = { ERC: true, JXCAT: true, BNG: true, CUP: true, PACMA: true };
const textoClase = (p: string) => (TEXTO_TINTA[p] ? 'hero-bar__texto--tinta' : '');
const signo = (v: number | null) => (v == null ? '—' : v > 0 ? `▲${entero(v)}` : v < 0 ? `▼${entero(-v)}` : '—');
const claseDelta = (v: number | null) => (v == null || v === 0 ? 'plano' : v > 0 ? 'sube' : 'baja');
---

<figure class="hero-bar" data-total={TOTAL} data-suma={sumaCentral}>
  <div class="hero-bar__visual" role="img" aria-label={descripcion}>
    <!-- Escritorio: barra horizontal + axis + ticks -->
    <div class="hero-bar__escritorio" data-vista="h" aria-hidden="true">
      <div class="hero-bar__eje">
        {[0, 100, 200, 300].map((v) => (
          <span class="hero-bar__eje-marca mono" style={`left:${pct(v)}%`}>{v}</span>
        ))}
        <span class="hero-bar__eje-marca hero-bar__eje-marca--fin mono" style={`left:${pct(TOTAL)}%`}>{TOTAL}</span>
      </div>

      <div class="hero-bar__pista">
        {[50, 100, 150, 200, 250, 300].map((v) => (
          <span class="hero-bar__pelo" style={`left:${pct(v)}%`} />
        ))}
        {tramos.map((f) => (
          <span
            class="hero-bar__tramo"
            style={`left:${pct(f.inicio)}%;width:${pct(f.ancho)}%;background:${colorPartido(f.partido)}`}
            data-partido={f.partido}
            data-central={f.central}
          >
            {f.central >= MIN_ETIQUETA && (
              <>
                <span class={`hero-bar__sigla ${textoClase(f.partido)}`}>{sigla29N(f.partido)}</span>
                <span class={`hero-bar__num ${textoClase(f.partido)}`} data-escano={f.central}>{entero(f.central)}</span>
              </>
            )}
            <span class="hero-bar__tip mono">
              <strong>{f.etiqueta}</strong> — escenario central {entero(f.central)} · IC95: {f.min}–{f.max} · 23J: {entero(f.esc23)}
            </span>
          </span>
        ))}
        <span class="hero-bar__mayoria" style={`left:${pct(MAYORIA)}%`} />
        <span class="hero-bar__mayoria-et mono" style={`left:${pct(MAYORIA)}%`}>Mayoría 176</span>
      </div>

      <div class="hero-bar__ticks" style={`height:${ticks.length * ALTO_CARRIL}px`}>
        <span class="hero-bar__ticks-mayoria" style={`left:${pct(MAYORIA)}%`} aria-hidden="true" />
        {ticks.map((f, i) => {
          const izq = pct(f.min);
          const der = pct(f.max);
          const ancho = Math.max(der - izq, 0.5);
          // Tres modos de rótulo, elegidos por geometría, no a ojo:
          //  - ancho y con sitio a la izquierda → pegado a la izquierda;
          //  - ancho y pegado al origen        → pegado a la derecha;
          //  - estrecho (< 6 %)                → guía de puntos y rótulo en
          //    columna al 46 %, para que ERC/EH/JXCAT no se apilen en la esquina.
          const estrecho = ancho < 6;
          const aLaIzquierda = !estrecho && izq >= 12;
          return (
            <>
              <span
                class="hero-bar__tick"
                data-tick
                data-partido={f.partido}
                style={`left:${izq}%;width:${ancho}%;top:${i * ALTO_CARRIL + 5}px`}
              />
              {estrecho && (
                <span
                  class="hero-bar__tick-guia"
                  style={`left:${der}%;width:${46 - der}%;top:${i * ALTO_CARRIL + 6}px`}
                />
              )}
              <span
                class={`hero-bar__tick-et mono ${aLaIzquierda ? 'hero-bar__tick-et--izq' : ''}`}
                style={
                  estrecho
                    ? `left:46%;top:${i * ALTO_CARRIL}px`
                    : aLaIzquierda
                      ? `right:${100 - izq}%;top:${i * ALTO_CARRIL}px`
                      : `left:${der}%;top:${i * ALTO_CARRIL}px`
                }
              >
                {sigla29N(f.partido)} {f.min}–{f.max}
              </span>
            </>
          );
        })}
      </div>
    </div>

    <!-- Móvil: mismas cifras en columnas verticales (eje 0–180, sin trampa) -->
    <div class="hero-bar__movil" data-vista="v">
      <div class="hero-bar__movil-fila hero-bar__movil-fila--valores">
        {columnas.map((f) => (
          <span class="hero-bar__col-valor mono">{entero(f.central)}</span>
        ))}
      </div>
      <div class="hero-bar__movil-plot" style={`height:${ALTURA_MOVIL}px`}>
        <span class="hero-bar__movil-mayoria" style={`bottom:${(MAYORIA / TOPE_MOVIL) * 100}%`}>
          <span class="hero-bar__movil-mayoria-et mono">mayoría 176</span>
        </span>
        {columnas.map((f) => (
          <span class="hero-bar__col-pista">
            <span
              class="hero-bar__col-barra"
              style={`height:${(f.central / TOPE_MOVIL) * 100}%;background:${colorPartido(f.partido)}`}
            />
            <span
              class="hero-bar__col-ic"
              style={`bottom:${(f.min / TOPE_MOVIL) * 100}%;height:${Math.max(((f.max - f.min) / TOPE_MOVIL) * 100, 1)}%`}
            />
          </span>
        ))}
      </div>
      <div class="hero-bar__movil-fila hero-bar__movil-fila--siglas">
        {columnas.map((f) => (
          <span class="hero-bar__col-sigla mono">{sigla29N(f.partido)}</span>
        ))}
      </div>
    </div>
    <p class="hero-bar__movil-nota mono">Escala 0–{TOPE_MOVIL} escaños · línea = mayoría 176 · ámbar = IC95</p>
  </div>

  {leyendaMenores.length > 0 && (
    <ul class="hero-bar__leyenda">
      <li class="hero-bar__leyenda-item">
        <span class="hero-bar__muestra hero-bar__muestra--ic" aria-hidden="true" />
        IC95
      </li>
      {leyendaMenores.map((f) => (
        <li class="hero-bar__leyenda-item mono">
          <span class="hero-bar__muestra" style={`background:${colorPartido(f.partido)}`} aria-hidden="true" />
          {sigla29N(f.partido)} <span data-escano={f.central}>{entero(f.central)}</span>
        </li>
      ))}
      <li class="hero-bar__leyenda-nota">Los partidos sin etiqueta en la barra, aquí.</li>
    </ul>
  )}

  {sumaRara && (
    <p class="hero-bar__nota mono">
      Escenario central por partido; la suma por partida simula {TOTAL} (aquí suma {entero(sumaCentral)}).
    </p>
  )}

  <DeltaDeActualizacion generado={generado} nRuns={nRuns} deltas={deltas} contra={contra} />

  <table class="hero-bar__tabla">
    <caption class="mono">
      Escenario central, intervalo del 95 % y escaños del 23J · la línea ámbar de la barra es el IC95 de cada partido con 5 escaños o más
    </caption>
    <thead>
      <tr>
        <th scope="col">Partido</th>
        <th scope="col">Esc.</th>
        <th scope="col">IC95</th>
        <th scope="col">23J</th>
        <th scope="col">Δ corrida</th>
      </tr>
    </thead>
    <tbody>
      {orden.map((f) => (
        <tr>
          <th scope="row">
            <span class="hero-bar__muestra" style={`background:${colorPartido(f.partido)}`} aria-hidden="true" />
            {f.etiqueta}
          </th>
          <td class="mono">{entero(f.central)}</td>
          <td class="mono">{f.min}–{f.max}</td>
          <td class="mono">{entero(f.esc23)}</td>
          <td class={`mono hero-bar__delta hero-bar__delta--${claseDelta(f.delta)}`} data-delta-partido={f.partido}>{signo(f.delta)}</td>
        </tr>
      ))}
    </tbody>
  </table>

  {pie && <p class="hero-bar__pie mono">{pie}</p>}
  {lectura && <p class="hero-bar__lectura">{lectura}</p>}
</figure>

<style>
  .hero-bar {
    margin: 0 0 var(--s-5);
    background: var(--papel);
    border-top: var(--borde-regla);
    border-bottom: var(--borde-regla);
    padding: var(--s-4) 0 var(--s-3);
  }

  /* --- Eje 0–350 ------------------------------------------------------- */
  .hero-bar__eje {
    position: relative;
    height: 16px;
    margin-bottom: 2px;
    font-size: 0.62rem;
    color: var(--tinta-3);
  }
  .hero-bar__eje-marca {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 0.62rem;
    letter-spacing: 0.02em;
  }
  .hero-bar__eje-marca:first-child { transform: none; }
  .hero-bar__eje-marca--fin { transform: translateX(-100%); }

  /* --- Barra ----------------------------------------------------------- */
  .hero-bar__pista {
    position: relative;
    height: 64px;
    border: 1px solid var(--tinta);
    background: var(--papel);
  }
  .hero-bar__pelo {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--papel);
    opacity: 0.55;
    z-index: 2;
  }
  .hero-bar__tramo {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    box-shadow: inset -1px 0 0 var(--papel);
    z-index: 1;
  }
  .hero-bar__sigla {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--papel);
  }
  .hero-bar__num {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    color: var(--papel);
  }
  .hero-bar__texto--tinta { color: var(--tinta); }

  .hero-bar__mayoria {
    position: absolute;
    top: -5px;
    bottom: -5px;
    width: 2px;
    background: var(--tinta);
    z-index: 3;
  }
  .hero-bar__mayoria-et {
    position: absolute;
    top: -18px;
    transform: translateX(-50%);
    font-size: 0.62rem;
    color: var(--tinta-2);
    white-space: nowrap;
    z-index: 4;
  }

  /* --- Capa de incertidumbre ------------------------------------------- */
  .hero-bar__ticks {
    position: relative;
    margin-top: 2px;
  }
  .hero-bar__tick {
    position: absolute;
    height: 4px;
    background: var(--intervalo-tick);
  }
  /* Rótulo del tick: a un lado de su propia línea, nunca encima. */
  .hero-bar__tick-et {
    position: absolute;
    padding-left: 6px;
    font-size: 0.6rem;
    line-height: 14px;
    color: var(--tinta-2);
    white-space: nowrap;
  }
  .hero-bar__tick-et--izq {
    padding-left: 0;
    padding-right: 6px;
    text-align: right;
  }
  /* El bloque de ticks va separado de la barra: la línea de mayoría no lo pisa. */
  .hero-bar__ticks { margin-top: 4px; }
  /* La mayoría sigue visible a través de las filas de IC95, en punteado: así se
     ve de un vistazo qué intervalos cruzan los 176. */
  .hero-bar__ticks-mayoria {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px dashed var(--tinta-3);
    opacity: 0.6;
  }
  .hero-bar__tick-guia {
    position: absolute;
    height: 0;
    border-top: 1px dotted var(--regla);
  }

  /* --- Tooltip: CSS puro, display:none fuera de hover (no ensancha el
         layout móvil; lección 15-10-2026 de BarraEscanos). ---------------- */
  .hero-bar__tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    display: none;
    background: var(--tinta);
    color: var(--papel);
    padding: 6px 10px;
    border-radius: 3px;
    font-size: 0.75rem;
    line-height: 1.5;
    white-space: nowrap;
    z-index: 8;
  }
  .hero-bar__tip strong { color: var(--papel); }
  .hero-bar__tramo:hover .hero-bar__tip { display: block; }
  .hero-bar__tramo:first-child .hero-bar__tip { left: 0; transform: none; }
  .hero-bar__tramo:nth-last-child(-n+3) .hero-bar__tip { left: auto; right: 0; transform: none; }

  /* --- Leyenda de menores ---------------------------------------------- */
  .hero-bar__leyenda {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    color: var(--tinta-2);
  }
  .hero-bar__leyenda-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--tinta);
  }
  .hero-bar__leyenda-nota {
    font-family: var(--f-mono);
    color: var(--tinta-3);
    font-size: 0.68rem;
  }
  .hero-bar__muestra {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 2px;
    flex: 0 0 auto;
  }
  .hero-bar__muestra--ic {
    inline-size: 14px;
    block-size: 4px;
    border-radius: 0;
    background: var(--intervalo-tick);
  }

  .hero-bar__nota {
    margin: var(--s-2) 0 0;
    font-size: 0.75rem;
    color: var(--alerta);
  }

  /* --- Tabla ----------------------------------------------------------- */
  .hero-bar__tabla {
    width: 100%;
    margin: var(--s-4) 0 0;
    border-top: var(--borde-tinta);
    border-collapse: collapse;
    font-size: var(--t-small);
  }
  .hero-bar__tabla caption {
    text-align: left;
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--tinta-3);
    padding-bottom: var(--s-1);
  }
  .hero-bar__tabla th,
  .hero-bar__tabla td {
    text-align: right;
    padding: 3px 0 3px var(--s-2);
    border-bottom: var(--borde-regla);
    font-weight: 400;
  }
  .hero-bar__tabla thead th {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tinta-2);
    border-bottom: var(--borde-tinta);
  }
  .hero-bar__tabla tbody th {
    text-align: left;
    padding-left: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .hero-bar__tabla tbody th:first-child,
  .hero-bar__tabla thead th:first-child { width: 40%; }
  .hero-bar__delta--sube { color: var(--ok); }
  .hero-bar__delta--baja { color: var(--alerta); }
  .hero-bar__delta--plano { color: var(--tinta-3); }

  .hero-bar__pie { margin: var(--s-3) 0 0; color: var(--tinta-2); font-size: 0.8125rem; }
  .hero-bar__lectura {
    margin: var(--s-2) 0 0;
    max-width: var(--medida);
    font-size: var(--t-small);
    line-height: var(--lh-small);
    color: var(--tinta-2);
  }

  /* --- Móvil: columnas verticales -------------------------------------- */
  .hero-bar__movil { display: none; }
  .hero-bar__movil-nota { display: none; }

  @media (max-width: 640px) {
    .hero-bar__escritorio { display: none; }
    .hero-bar__movil {
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding-top: var(--s-2);
    }
    .hero-bar__movil-fila { display: flex; gap: 4px; }
    .hero-bar__movil-fila > * { flex: 1 1 0; min-width: 0; text-align: center; }
    .hero-bar__col-valor { font-size: 0.66rem; color: var(--tinta); }
    /* El área de dibujo es una sola caja: la línea de mayoría la cruza entera y
       se lee como umbral, no como borde de cada columna. */
    .hero-bar__movil-plot {
      position: relative;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 4px;
      border-bottom: 1px solid var(--tinta);
    }
    .hero-bar__movil-mayoria {
      position: absolute;
      left: 0;
      right: 0;
      height: 0;
      border-top: 1px dashed var(--tinta-2);
      z-index: 0;
    }
    .hero-bar__movil-mayoria-et {
      position: absolute;
      right: 0;
      top: 0;
      transform: translateY(-100%);
      padding-left: 3px;
      background: var(--papel);
      font-size: 0.55rem;
      color: var(--tinta-2);
    }
    .hero-bar__col-pista {
      position: relative;
      flex: 1 1 0;
      min-width: 0;
      max-width: 34px;
      height: 100%;
      background: var(--papel-2);
      border-top: 1px solid var(--regla);
    }
    .hero-bar__col-barra {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1;
    }
    .hero-bar__col-ic {
      position: absolute;
      left: 50%;
      width: 4px;
      margin-left: -2px;
      background: var(--intervalo-tick);
      box-shadow: 0 0 0 1px var(--papel);
      z-index: 2;
    }
    /* Serifs horizontales del IC95: el «bigote» que evita leer el tick como
       una columna más. */
    .hero-bar__col-ic::before,
    .hero-bar__col-ic::after {
      content: '';
      position: absolute;
      left: -3px;
      width: 10px;
      height: 2px;
