---
/**
 * IntervalBand — la banda de intervalo (DESIGN.md §2, el color firma).
 *
 * Componente rey de la incertidumbre: cada fila es un partido (o una provincia)
 * con su punto y su intervalo. La mediana NUNCA viaja sin su banda.
 *
 * Modos:
 *  - con `filas` → gráfico real (banda p10–p90 en --intervalo, punto en --tinta).
 *  - sin datos  → esqueleto neutro en --papel-3, sin valores inventados.
 *
 * Accesibilidad (DESIGN.md §7): el gráfico lleva role="img" con la conclusión en
 * el aria-label y una tabla de datos alternativa en <details> con los mismos números.
 */
import { num } from '../lib/format';

export interface FilaIntervalo {
  etiqueta: string;
  punto: number;
  p10: number;
  p90: number;
  /** claro oscuro opcional para la muestra de partido (--p-xx) */
  color?: string;
  /** escaños estimados opcionales, para mostrarlos junto al valor */
  escanos?: number;
}

interface Props {
  filas?: FilaIntervalo[];
  /** tope de la escala; si se omite se calcula del propio dato */
  max?: number;
  unidad?: string;
  dec?: number;
  descripcion: string;
  pie?: string;
  lectura?: string;
  nota?: string;
}

const {
  filas = [],
  max,
  unidad = '%',
  dec = 1,
  descripcion,
  pie,
  lectura,
  nota,
} = Astro.props as Props;

const tope = max ?? Math.max(1, ...filas.map((f) => Math.max(f.p90, f.punto))) * 1.05;
const pos = (v: number) => Math.max(0, Math.min(100, (v / tope) * 100));
const f = (v: number) => num(v, dec);
const ticks = [0, 0.25, 0.5, 0.75, 1].map((t) => t * tope);
const conEscanos = filas.some((x) => x.escanos !== undefined);
---

<figure class="bandas">
  {filas.length > 0 ? (
    <div class="bandas__cuerpo" role="img" aria-label={descripcion}>
      <div class="bandas__eje" aria-hidden="true">
        {ticks.map((t) => <span class="bandas__tick mono">{f(t)}</span>)}
      </div>

      {filas.map((fila) => (
        <div class="fila">
          <span class="fila__etiqueta">
            {fila.color && <span class="fila__muestra" style={`background:${fila.color}`} aria-hidden="true"></span>}
            {fila.etiqueta}
          </span>
          <span class="fila__pista">
            <span
              class="fila__banda"
              style={`left:${pos(fila.p10)}%;width:${Math.max(pos(fila.p90) - pos(fila.p10), 0.4)}%;`}
              aria-hidden="true"
            ></span>
            <span class="fila__punto" style={`left:${pos(fila.punto)}%;`} aria-hidden="true"></span>
          </span>
          <span class="fila__valor mono">
            {f(fila.punto)}<span class="fila__unidad"> {unidad}</span>
            <span class="fila__ic">({f(fila.p10)}–{f(fila.p90)})</span>
            {fila.escanos !== undefined && <span class="fila__sec">· {num(fila.escanos, 1)} esc.</span>}
          </span>
        </div>
      ))}
    </div>
  ) : (
    <div class="bandas__esqueleto" role="img" aria-label={descripcion}>
      <span class="skeleton" style="width:100%"></span>
      <span class="skeleton" style="width:92%"></span>
      <span class="skeleton" style="width:80%"></span>
      <span class="skeleton" style="width:88%"></span>
      <span class="skeleton" style="width:64%"></span>
    </div>
  )}

  {pie && <p class="bandas__pie mono">{pie}</p>}
  {lectura && <p class="bandas__lectura">{lectura}</p>}
  {nota && <p class="small">{nota}</p>}

  <details class="bandas__datos">
    <summary>Cifras de este gráfico, en tabla</summary>
    {filas.length > 0 ? (
      <table class="tabla-datos">
        <thead>
          <tr><th scope="col">Serie</th><th scope="col" class="der">Punto</th><th scope="col" class="der">Límite inf. (p10)</th><th scope="col" class="der">Límite sup. (p90)</th>{conEscanos && <th scope="col" class="der">Escanos est.</th>}</tr>
        </thead>
        <tbody>
          {filas.map((fila) => (
            <tr>
              <th scope="row">{fila.etiqueta}</th>
              <td class="mono der">{f(fila.punto)} {unidad}</td>
              <td class="mono der">{f(fila.p10)} {unidad}</td>
              <td class="mono der">{f(fila.p90)} {unidad}</td>
              {conEscanos && <td class="mono der">{fila.escanos !== undefined ? num(fila.escanos, 1) : '—'}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="small">Sin datos todavía. La tabla llevará exactamente los mismos números que el gráfico.</p>
    )}
  </details>
</figure>

<style>
  .bandas {
    margin: 0 0 var(--s-5);
    background: var(--papel);
    border-top: var(--borde-regla);
    border-bottom: var(--borde-regla);
    padding: var(--s-4) 0;
  }

  .bandas__cuerpo { container-type: inline-size; }

  .bandas__eje {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--tinta-3);
    border-bottom: var(--borde-regla);
    padding-bottom: var(--s-1);
    margin-left: 30%;
    width: 70%;
  }
  .bandas__tick { font-family: var(--f-mono); }

  .fila {
    display: grid;
    grid-template-columns: 30% 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) 0;
    border-bottom: 1px solid transparent;
  }
  .fila:hover { background: var(--papel-2); }

  .fila__etiqueta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 600;
    font-size: var(--t-small);
    min-width: 0;
  }
  .fila__muestra { inline-size: 12px; block-size: 12px; border-radius: 2px; flex: 0 0 auto; }

  .fila__pista {
    position: relative;
    height: 22px;
    border-left: 1px solid var(--regla);
    border-right: 1px solid var(--regla);
    background-image: linear-gradient(to right, var(--regla) 0 1px, transparent 1px);
    background-size: 25% 100%;
  }
  .fila__banda {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 12px;
    background: var(--intervalo);
    border-radius: 2px;
  }
  .fila__punto {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 3px;
    height: 20px;
    background: var(--tinta);
    border-radius: 1px;
  }

  .fila__valor { font-size: var(--t-data); text-align: right; white-space: nowrap; }
  .fila__unidad { color: var(--tinta-2); }
  .fila__ic { color: var(--tinta-2); margin-left: var(--s-2); }
  .fila__sec { color: var(--tinta-3); margin-left: var(--s-2); }

  .bandas__esqueleto { display: grid; gap: var(--s-3); padding: var(--s-5) 0; }
  .bandas__esqueleto .skeleton { height: 12px; }

  .bandas__pie { margin: var(--s-3) 0 0; color: var(--tinta-2); font-size: 0.8125rem; }
  .bandas__lectura { margin: var(--s-2) 0 0; max-width: var(--medida); font-size: var(--t-small); line-height: var(--lh-small); color: var(--tinta-2); }

  .bandas__datos { margin-top: var(--s-3); }
  .bandas__datos summary {
    cursor: pointer;
    font-size: var(--t-small);
    font-weight: 600;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--enlace);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .tabla-datos { width: 100%; border-collapse: collapse; font-size: var(--t-data); }
  .tabla-datos th, .tabla-datos td { text-align: left; padding: var(--s-1) var(--s-3) var(--s-1) 0; border-bottom: var(--borde-regla); }
  .tabla-datos thead th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--tinta-2); }
  .tabla-datos .der { text-align: right; padding-right: 0; }

  @container (max-width: 620px) {
    .bandas__eje { display: none; }
    .fila { grid-template-columns: 1fr; gap: var(--s-1); }
    .fila__pista { order: 2; }
    .fila__valor { text-align: left; }
  }
</style>
