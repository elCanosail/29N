---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import IntervalBand from '../../components/IntervalBand.astro';
import HorquillasEscanos from '../../components/HorquillasEscanos.astro';
import MapaProvincial from '../../components/MapaProvincial.astro';
import seats from '../../data/seats.json';
import base23 from '../../data/base23.json';
import reparto23 from '../../data/reparto23.json';
import ccaaMap from '../../data/provincias-ccaa.json';
import { num, entero } from '../../lib/format';
import { colorPartido, nombre29N } from '../../lib/partidos';

const provincias = seats.provincias;
const nacional = seats.nacional;
const meta = seats.meta;

// --- Horquillas de escaños (plan horquillas-imop-29n.md §B) -----------
// El gráfico y la tabla publican EXACTAMENTE las simulaciones existentes en
// seats.json: aquí no se calcula ningún número nuevo de modelo.
// Coherencia dura antes de publicar (mismo criterio que la vista CCAA):
// el nacional cubre el universo modelado y la suma de medias es 350.
if (nacional.length !== base23.meta.universo_modelado.length) {
  throw new Error(
    `El nacional de seats.json tiene ${nacional.length} partidos y el universo modelado del 23J tiene ${base23.meta.universo_modelado.length}. Revisar seats.json.`,
  );
}
const sumaMediasNacional = nacional.reduce((acc, p) => acc + p.media, 0);
const toleranciaEscanos = meta.coherencia?.tolerancia ?? 0.1;
if (
  Math.abs(sumaMediasNacional - (meta.coherencia?.suma_medias_escanos ?? sumaMediasNacional)) > 0.02 ||
  Math.abs(sumaMediasNacional - 350) > toleranciaEscanos
) {
  throw new Error(
    `Coherencia nacional rota: la suma de medias de escaños es ${sumaMediasNacional} y el meta declara ${meta.coherencia?.suma_medias_escanos} (tolerancia ${toleranciaEscanos}). Revisar seats.json.`,
  );
}

// Escaños reales del 23J por familia del modelo: reparto23.json es la
// agregación canónica de elecciones.json (23J) que ya publica la portada en
// su tabla comparativa; recalcular la familia aquí rompería la coherencia
// del Δ con el resto del sitio.
const escanos23J = Object.fromEntries(
  (reparto23.familias as { partido: string; escanos: number }[]).map((f) => [f.partido, f.escanos]),
);

const filasHorquillas = [...nacional]
  .sort((a, b) => b.media - a.media)
  .map((p) => ({
    partido: p.partido,
    etiqueta: nombre29N(p.partido),
    color: colorPartido(p.partido),
    media: p.media,
    min: p.ic95[0],
    max: p.ic95[1],
    central: p.central_escenario,
    pGe1: p.p_ge1,
    esc23: escanos23J[p.partido] ?? 0,
    delta23: p.media - (escanos23J[p.partido] ?? 0),
  }));

const topHorquillas = filasHorquillas.slice(0, 3);
const descripcionHorquillas = `Escaños nacionales del 29N con su horquilla del 95 %: ${topHorquillas
  .map((f) => `${f.etiqueta} ${num(f.media, 1)} (${entero(f.min)}–${entero(f.max)})`)
  .join('; ')}. Mayoría absoluta: 176 escaños; ningún partido la alcanza dentro de su horquilla.`;
const provinciasMapa = provincias.map((p) => ({
  ...p,
  ganadorClave: p.ganador,
  ganador: nombre29N(p.ganador),
}));

const datosMapa = Object.fromEntries(
  provincias.map((p) => [
    String(p.codigo),
    Object.fromEntries(p.partidos.filter((x) => x.media > 0).map((x) => [x.partido, x.media])),
  ]),
);
const partidosMapa = Object.fromEntries(
  nacional.map((p) => [p.partido, { color: colorPartido(p.partido) }]),
);

const limites = [
  'Qué predecimos: los escaños por provincia del 29N, con su intervalo del 95 % sobre 10 000 simulaciones D\'Hondt.',
  'Qué no predecimos: el escaño exacto de un partido en una provincia, ni el desenlace de una provincia sin encuestas propias.',
  'Lo que el modelo no sabe, no se rellena: se publica el intervalo, la probabilidad de obtener escaño y el error del backtest.',
];

/** Filas del panel de una provincia: solo partidos con opción real. */
function filasProvincia(p: (typeof provincias)[number]) {
  return p.partidos
    .filter((x) => x.media >= 0.15 || x.ic95[1] >= 1)
    .map((x) => ({ etiqueta: nombre29N(x.partido), punto: x.media, p10: x.ic95[0], p90: x.ic95[1], color: colorPartido(x.partido) }));
}

// --- Agregación por comunidad autónoma --------------------------------
// Las CCAA no son circunscripción electoral (LOREG art. 161): esta sección no
// es un modelo autonómico, es la suma de las medias provinciales ya
// publicadas. La esperanza es aditiva; los intervalos no (no se suman
// intervalos provinciales, así que a nivel autonómico no se publican).
const provinciaPorCodigo = new Map(provincias.map((p) => [String(p.codigo), p]));

const filasCCAA = ccaaMap.ccaa.map((c) => {
  const provs = c.provincias.flatMap((code) => {
    const p = provinciaPorCodigo.get(String(code));
    return p ? [p] : [];
  });
  const escanos = provs.reduce((acc, p) => acc + p.escanos, 0);
  // Medias en céntimos de escaño: cada media publicada (2 decimales) pasa a
  // entero y la suma es aritmética entera exacta. Así el redondeo comercial a
  // un decimal no depende del orden en coma flotante (los .x5 exactos no
  // oscilan entre 8,3 y 8,4 según cómo se agrupen las sumas).
  const medias: Record<string, number> = {};
  for (const p of provs) {
    for (const x of p.partidos) {
      medias[x.partido] = (medias[x.partido] ?? 0) + Math.round(x.media * 100);
    }
  }
  return { codigo: c.codigo, nombre: c.nombre, escanos, medias };
});

/** Céntimos de escaño → un decimal (redondeo comercial, mitad arriba). */
const dec1 = (cents: number) => Math.round(cents / 10) / 10;

const sumaEscanosCCAA = filasCCAA.reduce((acc, c) => acc + c.escanos, 0);
// Compromiso del sitio: la suma autonómica ES la estatal. Si un cambio de
// datos rompe la coherencia, el build falla antes que publicarla mal.
if (sumaEscanosCCAA !== 350) {
  throw new Error(`Coherencia CCAA rota: las 52 provincias suman ${sumaEscanosCCAA} escaños en juego, no 350. Revisar seats.json y provincias-ccaa.json.`);
}

const filasCCAAOrden = [...filasCCAA].sort(
  (a, b) => b.escanos - a.escanos || a.nombre.localeCompare(b.nombre, 'es'),
);

// Columnas: las diez fuerzas con media estatal ≥ 1,5 escaños, en el orden
// nacional ya publicado; el resto del universo modelado (NA+, CUP, PACMA…)
// se agrega en «Otros», tal como está en las medias, sin recalcular nada.
const partidosCCAA = nacional.filter((p) => p.media >= 1.5).map((p) => p.partido);
const centOtros = (medias: Record<string, number>) =>
  Object.entries(medias).reduce(
    (acc, [partido, cents]) => (partidosCCAA.includes(partido) ? acc : acc + cents),
    0,
  );
const totalCCAAporPartido = Object.fromEntries(
  partidosCCAA.map((partido) => [
    partido,
    filasCCAA.reduce((acc, c) => acc + (c.medias[partido] ?? 0), 0),
  ]),
) as Record<string, number>;
const totalCCAAOtros = filasCCAA.reduce((acc, c) => acc + centOtros(c.medias), 0);
const sumaCentMediasCCAA = filasCCAA.reduce(
  (acc, c) => acc + Object.values(c.medias).reduce((a, b) => a + b, 0),
  0,
);
---

<Base
  titulo="Predicción 29N"
  descripcion="Predicción provincial del 29N: escaños por provincia con intervalo del 95 %, coherencia con la predicción estatal y error del backtest publicado."
>
  <div class="contenedor">
    <Breadcrumbs items={[{ label: 'Predicción 29N' }]} />

    <header class="cabecera-pagina">
      <p class="eyebrow entrada">Predicción provincial · swing + D'Hondt</p>
      <h1 class="medida entrada entrada--1">Predicción 29N</h1>
      <p class="titular-intro entrada entrada--2">
        Escaños por provincia con el intervalo del 95 % de 10 000 simulaciones.
      </p>
    </header>

    <!-- El encabezado no vende: el mapa es la recompensa, no el gancho -->
    

    <!-- Horquillas de escaños: la visual del reparto nacional (plan §B).
         Gráfico primero, tabla-resumen después (jerarquía electomanía propia). -->
    <section class="seccion--compacta" aria-labelledby="nacional-titulo">
      <p class="eyebrow" id="nacional-titulo">Nacional · escaños totales</p>
      <h2>Reparto nacional de escaños: horquilla del 95 % por partido</h2>
      <HorquillasEscanos
        filas={filasHorquillas}
        conTabla={true}
        descripcion={descripcionHorquillas}
        pie={`D'Hondt por provincia · ${entero(meta.n_runs)} simulaciones (semilla ${meta.seed}) · banda = percentiles 2,5–97,5 · punto = media · trazo = mediana del escenario central`}
        lectura="La banda ámbar es el intervalo del 95 % de las simulaciones: el reparto depende de cómo se rompan los empates en las últimas circunscripciones, así que ningún partido se publica con un escaño puntual. El punto marca la media y el trazo vertical, la mediana del escenario central. Con el IC95 publicado, ningún partido alcanzaría por sí solo la mayoría absoluta (176): el gobierno se decide en las sumas, no en un ganador claro."
        pieTabla={`Media, mediana y horquilla: ${entero(meta.n_runs)} simulaciones D'Hondt sobre la predicción provincial (seats.json). Escaños 23J: resultado real agregado por las familias del modelo (Ministerio del Interior, vía elecciones.json). Δ: media 29N menos escaños reales del 23J. La suma de medias difiere de 350 en ${num(meta.coherencia?.desviacion_escanos, 2)} escaños por el redondeo a un decimal.`}
      />
    </section>

    <!-- Agregación por comunidad autónoma: suma de lo ya publicado, sin modelo nuevo -->
    <section class="seccion--compacta" aria-labelledby="ccaa-titulo">
      <p class="eyebrow" id="ccaa-titulo">Por comunidad autónoma · agregación del modelo provincial</p>
      <h2>Los mismos 350 escaños, agrupados en 19 comunidades</h2>
      <p class="medida nota ccaa-intro">
        Las comunidades autónomas no son circunscripción electoral: el Congreso se
        reparte provincia a provincia. Esta tabla suma las medias publicadas de las
        provincias de cada comunidad. No es un modelo autonómico ni añade precisión:
        es la misma predicción provincial, leída en otro nivel. Los intervalos
        provinciales no se suman (sumar intervalos no es estadísticamente válido),
        así que aquí no se publican; los intervalos por partido y provincia siguen
        en la <a href="#tabla-paralela-titulo">tabla paralela</a> y los nacionales,
        en la sección superior.
      </p>

      <figure class="tabla-ccaa">
        <p class="tabla-ccaa__meta mono">
          Agregación propia de la predicción provincial publicada (generada el {meta.generado})
          · correspondencia provincia–comunidad: división territorial oficial (INE)
        </p>
        <div class="tabla-ccaa__marco">
          <table>
            <caption class="visualmente-oculto">
              Escaños estimados para el 29N por comunidad autónoma: media por partido sumada de sus provincias y escaños en juego
            </caption>
            <thead>
              <tr>
                <th scope="col">Comunidad</th>
                <th scope="col" class="der">Escaños</th>
                {partidosCCAA.map((partido) => (
                  <th scope="col" class="der">{nombre29N(partido)}</th>
                ))}
                <th scope="col" class="der">Otros</th>
              </tr>
            </thead>
            <tbody>
              {filasCCAAOrden.map((c) => (
                <tr>
                  <th scope="row">{c.nombre}</th>
                  <td class="mono der">{entero(c.escanos)}</td>
                  {partidosCCAA.map((partido) => (
                    <td class="mono der">{c.medias[partido] ? num(dec1(c.medias[partido]), 1) : '—'}</td>
                  ))}
                  <td class="mono der">{centOtros(c.medias) > 0 ? num(dec1(centOtros(c.medias)), 1) : '—'}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">Total</th>
                <td class="mono der">{entero(sumaEscanosCCAA)}</td>
                {partidosCCAA.map((partido) => (
                  <td class="mono der">{num(dec1(totalCCAAporPartido[partido]), 1)}</td>
                ))}
                <td class="mono der">{num(dec1(totalCCAAOtros), 1)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
        <figcaption class="nota ccaa-pie">
          Medias de escaños: suma de las medias provinciales publicadas, cada una con
          su intervalo en el desglose provincial. Las medias se publican a un decimal y
          su suma ({num(dec1(sumaCentMediasCCAA), 1)}) difiere de los 350 escaños en
          juego solo por el redondeo de cada media provincial (el propio modelo
          declara una desviación de {num(meta.coherencia?.desviacion_escanos, 2)} escaños sobre 350).
          «Otros» reúne el resto del universo modelado (NA+, CUP, PACMA…).
        </figcaption>
      </figure>
    </section>

    <section class="controles" aria-labelledby="controles-titulo">
      <h2 class="visualmente-oculto" id="controles-titulo">Controles del mapa</h2>
      <div class="campo">
        <label for="p-provincia">Provincia</label>
        <select id="p-provincia">
          <option value="">Elige una provincia</option>
          {provincias.map((p) => (
            <option value={p.codigo}>{p.nombre}</option>
          ))}
        </select>
      </div>
      <div class="campo">
        <label for="p-partido">Partido</label>
        <select id="p-partido">
          <option value="">Ganador esperado</option>
          {nacional.map((p) => (
            <option value={p.partido}>{nombre29N(p.partido)}</option>
          ))}
        </select>
      </div>
      <p class="nota controles__aviso">
        Provincia: abre el panel de esa provincia. Partido: recolorea el cartograma con
        los escaños esperados de ese partido en cada provincia (0 = sin expectativa).
        Funciona con JavaScript; sin él, los paneles siguen accesibles desde el
        cartograma y la tabla paralela.
      </p>
    </section>

    <section class="panel-doble" aria-labelledby="mapa-titulo">
      <div class="panel-mapa">
        <h2 id="mapa-titulo">Cartograma provincial</h2>
        <MapaProvincial
          provincias={provinciasMapa}
          descripcion="Cartograma de las 52 provincias con el partido de más escaños esperados el 29N."
        />
        <p class="nota mono" id="mapa-partido-actual" hidden></p>
      </div>

      <aside class="panel-provincia" aria-labelledby="provincia-titulo">
        <div class="panel-hint" id="provincia-titulo">
          <p class="eyebrow">Provincia seleccionada</p>
          <p class="estado-vacio">
            <strong>Elige una provincia</strong> en el cartograma o en la tabla paralela
            para ver su reparto de escaños con intervalo. El mapa y la tabla llevan al
            mismo panel; no hay ningún dato al que solo se acceda por el mapa.
          </p>
        </div>

        {provincias.map((p) => (
          <section class="prov-panel" id={`prov-${p.codigo}`}>
            <p class="eyebrow">Provincia seleccionada · código {p.codigo}</p>
            <h3 class="prov-panel__nombre">{p.nombre}</h3>
            <p class="mono prov-panel__meta">
              {entero(p.escanos)} escaños en juego · ganador esperado: <strong>{nombre29N(p.ganador)}</strong>
            </p>
            <IntervalBand
              filas={filasProvincia(p)}
              max={p.escanos}
              unidad="esc."
              descripcion={`${p.nombre}: partido más probable ${nombre29N(p.ganador)}, ${entero(p.escanos)} escaños en juego.`}
              lectura={`Con los datos disponibles, el intervalo del 95 % de ${nombre29N(p.ganador)} en ${p.nombre} es el que muestra la banda. El modelo no afina más: aquí está el error del backtest →`}
            />
            <p class="nota">
              <a href="/metodologia/#validacion">Cómo se valida este intervalo →</a>
            </p>
          </section>
        ))}
      </aside>
    </section>

    <!-- El mapa nunca es el único camino al dato (DESIGN.md §7.3) -->
    <section class="seccion--compacta" aria-labelledby="tabla-paralela-titulo">
      <h2 id="tabla-paralela-titulo">Tabla paralela de provincias</h2>
      <p class="medida nota">
        Los mismos datos del mapa, en tabla navegable por teclado. Cada fila abre el
        panel de su provincia. Ordenación por columna pendiente de JavaScript.
      </p>

      <figure class="tabla-prov">
        <p class="tabla-prov__meta">
          Fuente: <a href="https://infoelectoral.interior.gob.es" rel="noopener">Ministerio del Interior</a>
          <span class="mono">base provincial: {meta.base_provincial}</span>
        </p>
        <div class="tabla-prov__marco">
          <table>
            <caption class="visualmente-oculto">
              Escaños esperados por provincia el 29N: ganador, media e intervalo del 95 %
            </caption>
            <thead>
              <tr>
                <th scope="col">Provincia</th>
                <th scope="col">Ganador</th>
                <th scope="col" class="der">Media</th>
                <th scope="col" class="der">IC95</th>
                <th scope="col" class="der">P(≥1)</th>
                <th scope="col" class="der">Escaños</th>
              </tr>
            </thead>
            <tbody>
              {provincias.map((p) => {
                const g = p.partidos[0];
                return (
                  <tr>
                    <th scope="row"><a href={`#prov-${p.codigo}`}>{p.nombre}</a></th>
                    <td>{g ? nombre29N(g.partido) : '—'}</td>
                    <td class="mono der">{g ? num(g.media, 1) : '—'}</td>
                    <td class="mono der">{g ? `${entero(g.ic95[0])}–${entero(g.ic95[1])}` : '—'}</td>
                    <td class="mono der">{g ? num(g.p_ge1 * 100, 0) + ' %' : '—'}</td>
                    <td class="mono der">{entero(p.escanos)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </figure>

      <aside class="aviso-mrp">
        <p class="eyebrow">Mejora evaluada y descartada</p>
        <p>
          El modelo actual usa un <strong>swing proporcional uniforme</strong> desde 23J.
          Evaluamos un <strong>MRP</strong> (regresión multinivel con postestratificación,
          con 532.000 microdatos del CIS y censo del INE) como candidata a mejorar la
          desagregación provincial: en el backtest de 5 elecciones no superó al swing
          (gana el swing en 4 de 5 elecciones en ambos tests; el MRP anclado queda en
          el ruido). No se adopta. La comparación completa está en el repositorio
          público (<code>docs/notes/mrp.md</code>).
        </p>
      </aside>
    </section>

    <section class="limites" aria-labelledby="limites-titulo">
      <h2 id="limites-titulo">Qué predecimos y qué no</h2>
      <ul class="limites__lista">
        {limites.map((l) => <li>{l}</li>)}
      </ul>
      <p class="nota">
        Método: {meta.metodo} · base {meta.base_provincial} · {entero(meta.n_runs)} simulaciones
        (semilla {meta.seed}). Coherencia verificada: la suma de medias de escaños es{' '}
        <strong>{num(meta.coherencia?.suma_medias_escanos, 1)}</strong> y el agregado provincial
        coincide con la predicción estatal con una desviación máxima de{' '}
        <strong>{num(meta.coherencia?.max_desviacion_votos_pp, 3)} pp</strong>.
        <a href="/metodologia/#modelo">Ver metodología →</a>
      </p>
    </section>
  </div>
  <script type="application/json" id="datos-mapa" set:html={JSON.stringify(datosMapa)} />
  <script type="application/json" id="partidos-mapa" set:html={JSON.stringify(partidosMapa)} />
  <script is:inline>
  (function () {
    var datos = JSON.parse(document.getElementById('datos-mapa').textContent);
    var partidos = JSON.parse(document.getElementById('partidos-mapa').textContent);
    var selProv = document.getElementById('p-provincia');
    var selPart = document.getElementById('p-partido');
    if (!selProv || !selPart) return;

    selProv.addEventListener('change', function () {
      if (selProv.value) location.hash = '#prov-' + selProv.value;
    });

    function recolor(partido) {
      document.querySelectorAll('.celda[data-prov]').forEach(function (celda) {
        var codigo = celda.getAttribute('data-prov');
        var prov = datos[codigo] || {};
        if (!partido) {
          celda.style.setProperty('--c', celda.getAttribute('data-c'));
          celda.querySelector('.celda__gan').textContent = celda.getAttribute('data-gan');
          return;
        }
        var info = partidos[partido] || {};
        celda.style.setProperty('--c', info.color || 'var(--p-otros)');
        var media = prov[partido] || 0;
        celda.querySelector('.celda__gan').textContent =
          media > 0 ? (Math.round(media * 10) / 10).toString().replace('.', ',') : '0';
      });
      var pie = document.getElementById('mapa-partido-actual');
      if (pie) {
        pie.hidden = !partido;
        pie.textContent = partido
          ? 'Mapa coloreado por: ' + partido + ' — escaños esperados por provincia'
          : '';
      }
    }

    selPart.addEventListener('change', function () { recolor(selPart.value); });
  })();
  </script>
</Base>

<style>
  .cabecera-pagina { padding-block: var(--s-5) var(--s-4); }

  .limites {
    background: var(--papel-2);
    border-top: var(--borde-tinta);
    border-bottom: var(--borde-regla);
    padding: var(--s-5) var(--s-4);
    margin-bottom: var(--s-6);
  }
  .limites__lista { margin: 0 0 var(--s-3); padding-left: 1.2em; max-width: var(--medida); line-height: 1.7; }
  .limites .nota { max-width: 78ch; }

  .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: var(--borde-regla);
    margin-bottom: var(--s-6);
  }
  .controles .campo { min-width: 220px; margin-bottom: 0; }
  .controles__aviso { flex: 1 1 320px; margin: 0; }

  .panel-doble {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--s-6);
    align-items: start;
    padding-bottom: var(--s-6);
  }
  .panel-doble > * { min-width: 0; }
  .panel-mapa h2 { font-size: 1.3rem; }

  .panel-provincia {
    background: var(--papel-2);
    border: var(--borde-regla);
    border-radius: var(--radio);
    padding: var(--s-4);
    position: sticky;
    top: calc(var(--header-h) + var(--s-3));
