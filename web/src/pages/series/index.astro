---
/**
 * /series/ — la serie ponderada completa, 2015-2026, por bloques.
 *
 * Página de referencia para quien quiere la evolución y no la foto del día. Los
 * gráficos son el componente SerieLinea que ya usa la portada: aquí no se
 * calcula nada nuevo, solo se lee series.json.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SerieLinea from '../../components/SerieLinea.astro';
import seriesData from '../../data/series.json';
import { num } from '../../lib/format';
import { colorPartido, nombre29N } from '../../lib/partidos';
import { dataset } from '../../lib/seo';
import { slug } from '../../lib/slug';

const meses = (seriesData as any).meses as string[];
const series = (seriesData as any).series as Record<string, number[]>;
const claves = Object.keys(series);
const colores = Object.fromEntries(claves.map((p) => [p, colorPartido(p)]));
const etiquetas = Object.fromEntries(claves.map((p) => [p, nombre29N(p)]));

// Dos bloques por escala: los grandes juntos, los medianos juntos. Mezclarlos
// aplasta las líneas pequeñas contra el eje y no se lee nada.
const grandes = ['PP', 'PSOE', 'VOX', 'SUMAR'].filter((p) => p in series);
const medianos = ['EH BILDU', 'ERC', 'JXCAT', 'PNV', 'BNG', 'NA+', 'CUP', 'CC', 'PACMA'].filter(
  (p) => p in series,
);

// Ventana: la serie entera es útil, pero la última década es la que se consulta.
const desde = meses.indexOf('2018-01') >= 0 ? meses.indexOf('2018-01') : 0;
const mesesVentana = meses.slice(desde);
const recorta = (p: string) => series[p].slice(desde);

const ultimo = (p: string) => {
  const vals = series[p];
  for (let i = vals.length - 1; i >= 0; i--) if (typeof vals[i] === 'number') return vals[i];
  return null;
};

const jsonLd = dataset({
  nombre: 'Serie ponderada de intención de voto 2015–2026',
  descripcion:
    'Serie mensual de intención de voto por partido en España, media ponderada de encuestas publicadas, sobre voto válido.',
  ruta: '/series/',
  actualizado: `${meses[meses.length - 1]}-01`,
  cobertura: 'España',
  variables: ['intención de voto', 'mes'],
  creador: '29N',
});
---

<Base
  titulo="Series de intención de voto 2015–2026"
  descripcion="La serie mensual ponderada de cada partido desde 2015, en dos escalas para que se puedan leer, con el último dato y el enlace a su histórico completo."
  jsonLd={jsonLd}
>
  <div class="contenedor">
    <Breadcrumbs items={[{ label: 'Series' }]} />

    <header class="cabecera-pagina">
      <p class="eyebrow entrada">Series · {meses[0]} — {meses[meses.length - 1]}</p>
      <h1 class="medida entrada entrada--1">Cómo se ha movido el voto</h1>
      <p class="titular-intro entrada entrada--2">
        Media ponderada de las encuestas publicadas, mes a mes, sobre voto válido. No es un
        resultado oficial ni una predicción: es lo que decían las encuestas, ordenado en el tiempo.
      </p>
    </header>

    <section class="seccion" aria-labelledby="grandes">
      <h2 id="grandes" class="eyebrow">Los cuatro grandes</h2>
      <SerieLinea
        meses={mesesVentana}
        series={Object.fromEntries(grandes.map((p) => [p, recorta(p)]))}
        partidos={grandes}
        colores={colores}
        etiquetas={etiquetas}
        descripcion="Evolución mensual de PP, PSOE, VOX y SUMAR desde 2018"
        pie="Media ponderada de encuestas · % sobre voto válido"
      />
    </section>

    <section class="seccion" aria-labelledby="medianos">
      <h2 id="medianos" class="eyebrow">Los partidos medianos</h2>
      <SerieLinea
        meses={mesesVentana}
        series={Object.fromEntries(medianos.map((p) => [p, recorta(p)]))}
        partidos={medianos}
        colores={colores}
        etiquetas={etiquetas}
        descripcion="Evolución mensual de los partidos medianos desde 2018"
        pie="Media ponderada de encuestas · % sobre voto válido"
      />
    </section>

    <section class="seccion seccion--compacta" aria-labelledby="tabla">
      <h2 id="tabla" class="eyebrow">Último dato por partido</h2>
      <div class="tabla-envoltura">
        <table class="tabla">
          <thead>
            <tr><th scope="col">Partido</th><th scope="col" class="der">Último mes</th><th scope="col">Ver histórico</th></tr>
          </thead>
          <tbody>
            {claves
              .map((p) => ({ p, v: ultimo(p) }))
              .sort((a, b) => (b.v ?? 0) - (a.v ?? 0))
              .map(({ p, v }) => (
                <tr>
                  <td>
                    <span class="punto" style={`background:${colorPartido(p)}`} aria-hidden="true"></span>
                    {nombre29N(p)}
                  </td>
                  <td class="der num">{v !== null ? `${num(v)} %` : '—'}</td>
                  <td><a href={`/partidos/${slug(p)}/`}>Ver</a></td>
                </tr>
              ))}
          </tbody>
        </table>
      </div>
      <p class="nota">
        La serie se calcula en el pipeline con peso de recencia (vida media 45 días), tamaño
        muestral y calidad histórica de cada casa. Detalle en
        <a href="/metodologia/#modelo">metodología</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .tabla-envoltura { overflow-x: auto; max-width: 40rem; }
  .tabla { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .tabla th, .tabla td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--borde); }
  .tabla th { font-family: var(--f-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--tinta-2); }
  .tabla .der { text-align: right; }
  .punto { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px; }
</style>
