---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="La página solicitada no existe en 29N.">
  <div class="contenedor seccion">
    <p class="eyebrow">Error 404</p>
    <h1 class="medida">Esta página no existe</h1>
    <p class="medida nota">
      Puede que el enlace esté mal escrito o que la sección todavía no esté publicada.
      Desde la portada tienes las cuatro secciones del proyecto.
    </p>
    <p><a href="/">Volver a la portada →</a></p>
  </div>
</Base>
