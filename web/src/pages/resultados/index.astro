---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DataTable from '../../components/DataTable.astro';
import Timeline from '../../components/Timeline.astro';
import type { Columna } from '../../lib/tipos';

// Años de elecciones generales (hecho público, no dato inventado).
const elecciones = [
  '1977', '1979', '1982', '1986', '1989', '1993', '1996', '2000',
  '2004', '2008', '2011', '2015', '2016', 'A-2019', 'N-2019', '2023',
];
const hitos = elecciones.map((e) => ({ etiqueta: e, pendiente: true }));

const columnasEscanos: Columna[] = [
  { clave: 'candidatura', etiqueta: 'Candidatura' },
  { clave: 'escanos', etiqueta: 'Escaños', tipo: 'barra', escala: 200 },
  { clave: 'votos', etiqueta: '% votos', tipo: 'mono', alinear: 'der' },
  { clave: 'delta', etiqueta: 'Δ vs anterior', tipo: 'delta' },
];

const columnasComparador: Columna[] = [
  { clave: 'candidatura', etiqueta: 'Candidatura' },
  { clave: 'a', etiqueta: 'Elección A', tipo: 'mono', alinear: 'der' },
  { clave: 'b', etiqueta: 'Elección B', tipo: 'mono', alinear: 'der' },
  { clave: 'delta', etiqueta: 'Δ', tipo: 'delta' },
];
---

<Base
  titulo="Resultados 1977–2023"
  descripcion="Resultados oficiales de todas las elecciones generales españolas desde 1977, con escaños y porcentajes por candidatura."
>
  <div class="contenedor">
    <Breadcrumbs items={[{ label: 'Resultados' }]} />

    <header class="cabecera-pagina">
      <p class="eyebrow entrada">Escrutinio oficial · 1977–2023</p>
      <h1 class="medida entrada entrada--1">Resultados 1977–2023</h1>
      <p class="titular-intro entrada entrada--2">
        Los resultados oficiales del Ministerio del Interior, sin interpretación.
        Todo lo que viene después en esta web —series, swing, predicción— se apoya
        en estos números.
      </p>
    </header>

    <section class="seccion--compacta" aria-labelledby="cronologia-titulo">
      <h2 class="visualmente-oculto" id="cronologia-titulo">Línea temporal electoral</h2>
      <Timeline titulo="Elecciones generales" hitos={hitos} />
    </section>

    <section class="selector" aria-labelledby="selector-titulo">
      <h2 id="selector-titulo">Elección</h2>
      <div class="selector__controles">
        <div class="campo">
          <label for="e-eleccion">Elección</label>
          <select id="e-eleccion" disabled aria-describedby="selector-aviso">
            {elecciones.map((e) => <option>{e}</option>)}
          </select>
        </div>
        <p class="boton boton--secundario selector__boton" aria-disabled="true">Comparar elecciones</p>
      </div>
      <p class="nota" id="selector-aviso">
        Por defecto se mostrará la última elección disponible. Los controles se activan
        con los datos de la <strong>Fase 2</strong>.
        <span class="pendiente">en construcción — dato disponible en Fase 2</span>
      </p>
    </section>

    <section class="seccion--compacta" aria-labelledby="escanos-titulo">
      <h2 id="escanos-titulo">Escaños por candidatura</h2>
      <DataTable
        id="tabla-escanos"
        columnas={columnasEscanos}
        filas={[]}
        fuente={{ nombre: 'Ministerio del Interior — info electoral', url: 'https://infoelectoral.interior.gob.es' }}
        extraido="pendiente — Fase 2"
        vacio="Sin resultados cargados. El escrutinio provincial por candidatura (1977–2023) se publica al cerrar la Fase 2."
        nota="Las barras son proporcionales al número de escaños. El color de partido solo se usa dentro de la tabla y el gráfico, nunca como decoración de página (DESIGN.md §2)."
      />
      <p class="descargas">
        <span class="boton boton--fantasma" aria-disabled="true">Descargar CSV</span>
        <span class="boton boton--fantasma" aria-disabled="true">Descargar disco de resultados</span>
      </p>
    </section>

    <section class="seccion--compacta comparador" aria-labelledby="comparador-titulo">
      <h2 id="comparador-titulo">Comparador</h2>
      <p class="medida nota">
        Dos elecciones lado a lado. El color marca únicamente el signo de la diferencia
        (<span class="mono">+</span>/<span class="mono">−</span>); el valor va siempre en tinta.
      </p>
      <div class="comparador__selectores">
        <div class="campo">
          <label for="c-a">Elección A</label>
          <select id="c-a" disabled><option>—</option></select>
        </div>
        <div class="campo">
          <label for="c-b">Elección B</label>
          <select id="c-b" disabled><option>—</option></select>
        </div>
      </div>
      <DataTable
        id="tabla-comparador"
        columnas={columnasComparador}
        filas={[]}
        vacio="Selecciona dos elecciones para comparar. Disponible en la Fase 2."
      />
    </section>

    <section class="seccion--compacta" aria-labelledby="contexto-titulo">
      <h2 id="contexto-titulo">Nota de contexto</h2>
      <p class="cita-metodo" id="contexto-nota">
        Cada elección llevará su nota editorial —disoluciones, pactos, particularidades
        del censo— en Newsreader itálica. Todavía no hay ninguna escrita:
        <span class="pendiente">en construcción — dato disponible en Fase 2</span>.
      </p>
    </section>
  </div>
</Base>

<style>
  .cabecera-pagina { padding-block: var(--s-5) var(--s-6); }

  .selector { border-top: var(--borde-tinta); padding-top: var(--s-4); margin-bottom: var(--s-6); }
  .selector h2 { font-size: 1.3rem; }
  .selector__controles {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--s-4);
  }
  .selector__controles .campo { min-width: 220px; margin-bottom: 0; }
  .selector__boton { cursor: not-allowed; opacity: 0.55; }

  .descargas { display: flex; flex-wrap: wrap; gap: var(--s-4); }
  .descargas .boton { cursor: not-allowed; opacity: 0.7; }

  .comparador__selectores {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin-bottom: var(--s-4);
  }
  .comparador__selectores .campo { min-width: 200px; }
</style>
