---
import Base from '../layouts/Base.astro';
import IntervalBand from '../components/IntervalBand.astro';
import BarraEscanos from '../components/BarraEscanos.astro';
import SerieLinea from '../components/SerieLinea.astro';
import forecast from '../data/forecast.json';
import seatsData from '../data/seats.json';
import repartoData from '../data/reparto23.json';
import seriesData from '../data/series.json';
import encuestasData from '../data/encuestas.json';
import eleccionesData from '../data/elecciones.json';
import microdatosPorAnio from '../data/microdatos/por_anio.json';
import { num, entero, fechaLarga } from '../lib/format';
import { colorPartido } from '../lib/partidos';

const meta = forecast.meta;
const top = forecast.partidos.slice(0, 4);
// Cuenta atrás al día de la votación (2026-11-29); el cliente la recalcula al cargar.
const diasRestantes = Math.max(0, Math.ceil((Date.parse('2026-11-29T00:00:00Z') - Date.now()) / 86400000));
// El conjunto de datos: números reales del corpus (los metadatos del agregador
// de microdatos + las encuestas indexadas). Nada inventado.
const dataset = {
  nEntrevistas: microdatosPorAnio.meta.n_entrevistas,
  nEstudios: microdatosPorAnio.meta.n_estudios,
  anios: 2025 - 1977 + 1,
};
const nEncuestasPrivadas = encuestasData.encuestas.length;
const entrevistasFmt = dataset.nEntrevistas.toLocaleString('es-ES');
const resto = forecast.partidos.slice(4);
// Escaños estimados por partido (del modelo provincial), para pintarlos junto
// al voto en las bandas de la sección «Qué dicen las encuestas».
const escanosPorPartido = Object.fromEntries(
  seatsData.nacional.map((p: {partido: string; media: number}) => [p.partido, p.media]),
);
const aFila = (p: (typeof forecast.partidos)[number]) => ({
  etiqueta: p.partido,
  punto: p.punto,
  p10: p.p10,
  p90: p.p90,
  color: colorPartido(p.partido),
  escanos: escanosPorPartido[p.partido] as number | undefined,
});
const filasTop = top.map(aFila);
const filasResto = resto.map(aFila);

// El resultado en escaños: sumas del modelo provincial (10.000 simulaciones D'Hondt).
const nacional = seatsData.nacional.map((p: {partido: string; media: number; ic95: number[]}) => ({
  etiqueta: p.partido,
  punto: p.media,
  p10: p.ic95[0],
  p90: p.ic95[1],
  color: colorPartido(p.partido),
}));
const topNacional = nacional.slice(0, 4);
const restoNacional = nacional.slice(4);

// Comparación 23J: escaños, votos y % agregados por familia (ver reparto23.json).
const real23 = Object.fromEntries(
  (repartoData.familias as {partido: string; escanos: number; pct: number}[]).map((f) => [
    f.partido,
    {escanos: f.escanos, pct: f.pct},
  ]),
);
const pct29N = Object.fromEntries(
  (forecast.partidos as {partido: string; punto: number}[]).map((p) => [p.partido, p.punto]),
);
const filasReparto = nacional
  .map((p) => ({
    partido: p.etiqueta,
    estimacionEscanos: p.punto,
    estimacionPct: pct29N[p.etiqueta] ?? 0,
    realEscanos: real23[p.etiqueta]?.escanos ?? 0,
    realPct: real23[p.etiqueta]?.pct ?? 0,
  }))
  .filter((f) => f.estimacionEscanos >= 0.1 || f.realEscanos > 0);

// Serie reciente: últimos 36 meses, cuatro partidos grandes.
const meses = seriesData.meses as string[];
const corte = Math.max(0, meses.length - 36);
const mesesV = meses.slice(corte);
const partidosSerie = ['PP', 'PSOE', 'VOX', 'SUMAR'] as const;
const seriesV: Record<string, number[]> = Object.fromEntries(
  partidosSerie.map((p) => [p, (seriesData.series as Record<string, number[]>)[p].slice(corte)]),
);
const ultimoDe = (p: string) => (seriesV[p] ? seriesV[p][seriesV[p].length - 1] : 0);
const coloresSerie: Record<string, string> = Object.fromEntries(
  partidosSerie.map((p) => [p, colorPartido(p)]),
);

const ultima = eleccionesData.elecciones[eleccionesData.elecciones.length - 1];
const topEscrutinio = ultima.candidaturas.slice(0, 5);

const compromisos = [
  'Todo dato de la web es trazable a su fuente y clicable.',
  'El error del backtest se publica, sin maquillaje.',
  'Las predicciones llevan intervalos, nunca cifras puntuales.',
  'Las sumas provinciales cuadran con la predicción estatal.',
  'Log de exclusiones público: una encuesta que no valida se documenta.',
];

const anioUltimo = meta.ultimo_mes_con_dato ? meta.ultimo_mes_con_dato.slice(0, 7) : '—';
---

<Base titulo="Portada">
  <!-- 1. Bloque héroe: el resultado en escaños — la home abre con el gráfico -->
  <section class="contenedor seccion seccion--compacta heroe-apertura" aria-labelledby="resultado-titulo">
    <h1 class="visualmente-oculto">Estimación de resultados del 29N</h1>
    <div class="heroe__cabecera">
      <div>
        <p class="eyebrow" id="resultado-titulo">Así queda el Congreso<span data-cuenta-atras> · a <span data-dias>{diasRestantes}</span> <span data-unidad>días</span> de la votación</span></p>
        <h2>Los 350 escaños del 29N que proyecta el modelo</h2>
      </div>
      <p class="heroe__meta mono">
        Objetivo {meta.mes_predicho} · 10.000 simulaciones D'Hondt provincia a provincia
      </p>
    </div>

    <BarraEscanos
      filas={filasReparto}
      descripcion={`Reparto de escaños, estimación 29N frente al resultado real de 23J: ${filasReparto.slice(0, 4).map((f) => `${f.partido} ${num(f.estimacionEscanos, 1)} esc y ${num(f.estimacionPct, 1)} % frente a ${entero(f.realEscanos)} esc y ${num(f.realPct, 1)} %`).join('; ')}. El triángulo indica los escaños de más o de menos frente al 23J real. En la barra del 23J, los partidos del acuerdo de gobierno aparecen agrupados a la izquierda, empezando por el PSOE.`}
      pie={`Estimación: media ponderada de encuestas + swing proporcional provincial + 10.000 simulaciones D'Hondt · ▲▼ = escaños de más o de menos frente al 23J real · ${meta.mes_predicho}`}
      lectura={`La comparación se hace por familias políticas idénticas a las del modelo (PSOE incluye PSC, PSE-EE, PSdeG, PSIB-PSOE y PSN-PSOE; SUMAR incluye ECP, Compromís, Sumar Aragón y Més). La precisión de cada estimación —media nunca sin su intervalo— está en el desglose de abajo.`}
    />

    <details class="heroe__resto">
      <summary>Ver la precisión: banda de cada estimación (p10–p90), los 13 partidos</summary>
      <IntervalBand
        filas={topNacional}
        max={170}
        unidad="escaños"
        descripcion={`Estimación de escaños para el 29N: ${topNacional[0].etiqueta} ${num(topNacional[0].punto, 1)}, ${topNacional[1].etiqueta} ${num(topNacional[1].punto, 1)}, ${topNacional[2].etiqueta} ${num(topNacional[2].punto, 1)} y ${topNacional[3].etiqueta} ${num(topNacional[3].punto, 1)}, con su intervalo del 95 %.`}
        pie={`Modelo: media ponderada de encuestas + swing proporcional provincial · 10.000 simulaciones con reparto D'Hondt por provincia · intervalo: percentiles 2,5–97,5 de la simulación`}
      />
      <IntervalBand
        filas={restoNacional}
        max={170}
        unidad="escaños"
        descripcion="Estimación de escaños para el 29N del resto de partidos del universo modelado, con su intervalo del 95 %."
        pie="Mismo método y misma simulación que el gráfico anterior."
      />
    </details>

    
  </section>

  <!-- 2. Bloque héroe: estimación de voto estatal con intervalos ------------ -->
  <section class="contenedor seccion seccion--compacta" aria-labelledby="heroe-titulo">
    <div class="heroe__cabecera">
      <div>
        <p class="eyebrow" id="heroe-titulo">El detalle · estimación de voto estatal · intervalo del 80 %</p>
        <h2>Qué dicen las encuestas sobre el 29N</h2>
      </div>
      <p class="heroe__meta mono">
        Objetivo {meta.mes_predicho} · último dato {anioUltimo} · cobertura del universo{' '}
        {num(meta.normalizacion?.cobertura_universo_23J_pct, 1)} % (23J)
      </p>
    </div>

    <IntervalBand
      filas={filasTop}
      max={45}
      unidad="%"
      descripcion={`Predicción estatal 29N: los cuatro primeros partidos con su intervalo del 80 % y su estimación de escaños. PP ${num(filasTop[0].punto)} por ciento, PSOE ${num(filasTop[1].punto)}, VOX ${num(filasTop[2].punto)}, Sumar ${num(filasTop[3].punto)}. Escaños estimados: PP ${num(filasTop[0].escanos ?? 0)}, PSOE ${num(filasTop[1].escanos ?? 0)}, VOX ${num(filasTop[2].escanos ?? 0)}, Sumar ${num(filasTop[3].escanos ?? 0)}.`}
      pie={`Método: ${meta.metodo_primario === 'baseline' ? 'media ponderada de encuestas (baseline)' : meta.metodo_primario} · Backtest MAE: ${num(meta.backtest_mae?.baseline, 3)} pp (n = ${meta.backtest_mae?.n}) · Intervalos empíricos, no probabilidad de resultado`}
      lectura={`La línea marca el punto y la banda el intervalo del 80 % (cuantiles 0,1–0,9 de los errores del backtest). El intervalo de Sumar (±${num((filasTop[3].p90 - filasTop[3].p10) / 2, 1)} pp) es ancho porque su familia arrastra el descalabro de Podemos en 2015–2019: es honesto, no un defecto.`}
    />

    <details class="heroe__resto">
      <summary>Ver los 13 partidos del universo modelado (con su intervalo)</summary>
      <IntervalBand
        filas={filasResto}
        max={25}
        unidad="%"
        descripcion="Predicción estatal 29N para los partidos del universo modelado con menos peso, con su intervalo del 80 %."
        pie="Mismo método y mismo intervalo que el gráfico anterior."
      />
    </details>

    
  </section>

  <!-- 2b. De dónde viene el número: serie reciente -------------------------- -->
  <section class="contenedor seccion seccion--compacta" aria-labelledby="serie-titulo">
    <p class="eyebrow" id="serie-titulo">De dónde viene el número</p>
    <h2>La serie que alimenta el modelo</h2>
    <SerieLinea
      meses={mesesV}
      series={seriesV}
      partidos={[...partidosSerie]}
      colores={coloresSerie}
      descripcion={`Media ponderada de encuestas, últimos 36 meses: PP ${num(ultimoDe('PP'), 1)} por ciento, PSOE ${num(ultimoDe('PSOE'), 1)}, VOX ${num(ultimoDe('VOX'), 1)}, Sumar ${num(ultimoDe('SUMAR'), 1)}.`}
      pie="Serie mensual ponderada × recencia (vida media 45 días) × muestra × calidad, corregida por efectos de casa."
      lectura="Esta línea es un promedio de encuestas, no un resultado ni una predicción; por eso va sin banda. La predicción con intervalo está arriba. El corpus completo arranca en 1979 y está en el explorador de encuestas."
    />
  </section>

  <!-- 3a. El conjunto de datos: tamaño y profundidad ------------------------ -->
  <section class="contenedor seccion seccion--compacta" aria-labelledby="dataset-titulo">
    <p class="eyebrow" id="dataset-titulo">El conjunto de datos</p>
    <h2>Tamaño y profundidad del dataset</h2>

    <div
      class="dataset"
      role="img"
      aria-label={`El dataset del modelo: ${entrevistasFmt} entrevistas individuales del CIS en ${dataset.nEstudios} estudios con microdatos, ${dataset.anios} años de historia (1977–2025), 52 provincias, ${nEncuestasPrivadas} encuestas privadas indexadas y 10.000 simulaciones D'Hondt por estimación.`}
    >
      <div class="dataset__cifra">
        <span class="dataset__numero dataset__numero--acento">{entrevistasFmt}</span>
        <span class="dataset__etiqueta">entrevistas individuales del CIS</span>
      </div>
      <div class="dataset__cifra">
        <span class="dataset__numero">{dataset.nEstudios}</span>
        <span class="dataset__etiqueta">estudios con microdatos</span>
      </div>
      <div class="dataset__cifra">
        <span class="dataset__numero">{dataset.anios}</span>
        <span class="dataset__etiqueta">años de historia (1977–2025)</span>
      </div>
      <div class="dataset__cifra">
        <span class="dataset__numero">52</span>
        <span class="dataset__etiqueta">provincias, una a una</span>
      </div>
      <div class="dataset__cifra">
        <span class="dataset__numero">{nEncuestasPrivadas}</span>
        <span class="dataset__etiqueta">encuestas privadas indexadas</span>
      </div>
      <div class="dataset__cifra">
        <span class="dataset__numero">10.000</span>
        <span class="dataset__etiqueta">simulaciones D'Hondt por estimación</span>
      </div>
    </div>

    <p class="dataset__nota">
      Cada estimación de esta web se apoya en todo lo anterior. Los microdatos están
      abiertos y son explorables en la sección <a href="/microdatos/">Microdatos CIS</a>.
    </p>
  </section>

  <!-- 3. El desglose: tres entradas asimétricas (2/3 + 1/3, escalonadas) --- -->
  <section class="contenedor seccion entradas" aria-labelledby="entradas-titulo">
    <p class="eyebrow" id="entradas-titulo">El desglose</p>
    <h2 class="visualmente-oculto">Secciones del proyecto</h2>

    <a class="entrada-link entrada-link--a" href="/encuestas/">
      <p class="eyebrow">Explorador de encuestas</p>
      <h3>Qué se ha preguntado, cuándo y con qué muestra</h3>
      <p class="entrada-link__texto">
        Índice de encuestas preelectorales y barométricas, cada una con su ficha
        técnica enlazada y su estado de validación.
      </p>
      <p class="mono entrada-link__dato">
        N = {entero(encuestasData.meta.n)} encuestas indexadas · {entero(encuestasData.meta.n_cis)} del CIS,{' '}
        {entero(encuestasData.meta.n_privados)} de privados →
      </p>
    </a>

    <a class="entrada-link entrada-link--b" href="/resultados/">
      <p class="eyebrow">Resultados 1977–2023</p>
      <h3>Escrutinio oficial, provincia a provincia</h3>
      <p class="entrada-link__texto">
        Escaños y porcentajes de cada general, con comparador entre dos elecciones.
      </p>
      <ul class="mini-escrutinio mono">
        {topEscrutinio.map((c) => (
          <li>
            <span class="mini-escrutinio__n">{entero(c.escanos)}</span>
            <span class="mini-escrutinio__s">{c.sigla}</span>
          </li>
        ))}
      </ul>
      <p class="mono entrada-link__dato">
        {fechaLarga(ultima.fecha)} · escaños de las cinco primeras candidaturas →
      </p>
    </a>

    <a class="entrada-link entrada-link--c" href="/prediccion/">
      <p class="eyebrow">Proyección provincial 29N</p>
      <h3>Qué predecimos y qué no</h3>
      <p class="entrada-link__texto">
        Escaños por provincia con su intervalo del 95 %, la suma cuadrada con la
        predicción estatal y el error del backtest publicado al lado.
      </p>
      <p class="mono entrada-link__dato">
        52 provincias · suma de medias = 350 escaños · ver el mapa y la tabla →
      </p>
    </a>
  </section>

  <!-- 4. Banda de metodología: la firma de confianza ----------------------- -->
    <!-- Aclaraciones y método: la zona baja (regla de jerarquía) -------------- -->
  <section class="aclaraciones" aria-labelledby="aclaraciones-titulo">
    <div class="contenedor aclaraciones__inner">
      <h2 class="visualmente-oculto" id="aclaraciones-titulo">Aclaraciones y método</h2>
<aside class="aviso-metodo" aria-labelledby="aviso-escanos-titulo">
      <p class="eyebrow" id="aviso-escanos-titulo">Qué es esta estimación</p>
      <p>
        Es la proyección del modelo, ni encuesta ni sondeo de intención: cada simulación
        reparte los 350 escaños con D'Hondt en las 52 provincias. Los intervalos reflejan
        el error que el método cometió en las últimas cinco elecciones, publicado sin
        maquillaje en la metodología.
      </p>
      <p class="nota">
        <a href="/prediccion/">Desglose por provincia →</a>
        <a href="/metodologia/#validacion">Ver el backtest completo →</a>
      </p>
    </aside>
<aside class="aviso-metodo" aria-labelledby="aviso-titulo">
      <p class="eyebrow" id="aviso-titulo">Advertencia metodológica</p>
      <p>{meta.advertencia}</p>
      <p class="nota">
        <a href="/metodologia/#validacion">Ver el backtest completo (MAE por partido y por elección) →</a>
      </p>
    </aside>
    </div>
  </section>

<section class="metodologia" aria-labelledby="metodologia-titulo">
    <div class="contenedor metodologia__inner">
      <p class="eyebrow" id="metodologia-titulo">Compromisos metodológicos</p>
      <ol class="metodologia__lista">
        {compromisos.map((c) => <li>{c}</li>)}
      </ol>
      <p class="metodologia__dato mono">
        Backtest: MAE baseline {num(meta.backtest_mae?.baseline, 3)} pp · TimesFM {num(meta.backtest_mae?.timesfm, 3)} pp
        (no mejora) · error absoluto medio de los privados en 23J: 1,73–2,32 pp
      </p>
      <p><a href="/metodologia/">Leer la metodología completa y el log de exclusiones →</a></p>
    </div>
  </section>
</Base>

<style>
  .aclaraciones__inner {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .aclaraciones__inner .aviso-metodo { margin: 0; }

  .heroe-apertura { padding-top: var(--s-4); }

  .dataset {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: var(--borde-tinta);
    border-bottom: var(--borde-tinta);
  }
  .dataset__cifra {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-4) var(--s-3);
    border-right: var(--borde-regla);
  }
  .dataset__cifra:nth-child(3n) { border-right: none; }
  .dataset__cifra:nth-child(n+4) { border-top: var(--borde-regla); }
  .dataset__numero {
    font-family: var(--f-titular);
    font-weight: 800;
    font-size: 2rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--tinta);
  }
  .dataset__numero--acento { color: var(--intervalo); }
  .dataset__etiqueta { font-size: var(--t-small); color: var(--tinta-2); line-height: 1.3; }
  .dataset__nota { margin: var(--s-3) 0 0; font-size: var(--t-small); color: var(--tinta-2); max-width: var(--medida); }

  @media (max-width: 767px) {
    .dataset { grid-template-columns: repeat(2, 1fr); }
    .dataset__cifra:nth-child(3n) { border-right: var(--borde-regla); }
    .dataset__cifra:nth-child(2n) { border-right: none; }
    .dataset__cifra:nth-child(n+3) { border-top: var(--borde-regla); }
    .dataset__numero { font-size: 1.5rem; }
  }

  .heroe__cabecera {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .heroe__cabecera h2 { margin: 0; }
  .heroe__meta { margin: 0; font-size: 0.8125rem; color: var(--tinta-2); max-width: 40ch; }
  .heroe__resto { margin-top: var(--s-2); }
  .heroe__resto summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; color: var(--enlace); }

  .aviso-metodo {
    background: var(--papel-2);
    border-left: 4px solid var(--tinta);
    padding: var(--s-3) var(--s-4);
    margin-top: var(--s-4);
    max-width: 78ch;
    font-size: var(--t-small);
    line-height: var(--lh-small);
  }
  .aviso-metodo p { margin: 0 0 var(--s-2); }
  .aviso-metodo .nota a { display: inline-block; padding: 8px 0; }

  /* --- Entradas asimétricas: ni grid de tarjetas ni cajas --------------- */
  .entradas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6);
    border-top: var(--borde-tinta);
    padding-top: var(--s-6);
  }
  .entrada-link {
    display: block;
    color: var(--tinta);
    text-decoration: none;
    padding-top: var(--s-3);
    border-top: var(--borde-regla);
  }
  .entrada-link--a { grid-column: 1 / span 2; }
  .entrada-link--b { grid-column: 3; margin-top: var(--s-6); }
  .entrada-link--c { grid-column: 2 / span 2; margin-top: var(--s-7); }
  .entrada-link h3 { margin-bottom: var(--s-2); font-family: var(--f-titular); font-size: 1.4rem; }
  .entrada-link:hover h3 { text-decoration: underline; text-underline-offset: 0.18em; }
  .entrada-link__texto { font-size: var(--t-small); line-height: var(--lh-small); color: var(--tinta-2); max-width: 46ch; }
  .entrada-link__dato { margin: 0; font-size: 0.8125rem; color: var(--tinta-2); }

  .mini-escrutinio {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin: var(--s-4) 0 var(--s-3);
    padding: 0;
  }
  .mini-escrutinio__n { font-size: 1.4rem; font-weight: 500; margin-right: 0.25em; }
  .mini-escrutinio__s { font-size: 0.8125rem; color: var(--tinta-2); }

  @media (max-width: 900px) {
    .entradas { grid-template-columns: 1fr; gap: var(--s-5); }
    .entrada-link--a, .entrada-link--b, .entrada-link--c { grid-column: 1; margin-top: 0; }
  }

  /* --- Banda de metodología (fondo --papel-2, borde superior 2 px) ------- */
  .metodologia {
    background: var(--papel-2);
    border-top: var(--borde-tinta);
    border-bottom: var(--borde-regla);
    padding-block: var(--s-6);
    margin-top: var(--s-7);
  }
  .metodologia__lista {
    margin: 0 0 var(--s-4);
    padding-left: 1.2em;
    max-width: var(--medida);
    font-size: var(--t-small);
    line-height: 1.7;
  }
  .metodologia__dato { font-size: 0.8125rem; color: var(--tinta-2); margin: 0 0 var(--s-3); }
</style>

<script>
  // Cuenta atrás del héroe: recalculada en el cliente para no depender del último build.
  const diasEl = document.querySelector('[data-dias]');
  if (diasEl) {
    const dias = Math.ceil((Date.parse('2026-11-29T00:00:00Z') - Date.now()) / 86400000);
    if (dias <= 0) {
      diasEl.closest('[data-cuenta-atras]')?.remove();
    } else {
      diasEl.textContent = String(dias);
      const unidad = document.querySelector('[data-unidad]');
      if (unidad) unidad.textContent = dias === 1 ? 'día' : 'días';
    }
  }
</script>
