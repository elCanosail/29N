---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DataTable from '../../components/DataTable.astro';
import SourceCard from '../../components/SourceCard.astro';
import encuestasData from '../../data/encuestas.json';
import exclusionesData from '../../data/exclusiones.json';
import { num, entero, campo, fechaCorta } from '../../lib/format';
import type { Columna, Fila, AtributosFila } from '../../lib/tipos';

const encuestas = encuestasData.encuestas;
const { casas, anios, elecciones } = encuestasData.dimensiones;

const idx = (lista: (string | number)[], valor: unknown) => lista.indexOf(valor as never);
/** Visualiza el ámbito en español de España. */
const ambito = (a: string | null) => {
  if (!a) return '—';
  if (a === 'estatal' || a === 'nacional') return 'Estatal';
  return a;
};

const cols: Columna[] = [
  { clave: 'id', etiqueta: 'ID encuesta', tipo: 'mono' },
  { clave: 'casa', etiqueta: 'Casa' },
  { clave: 'tipo', etiqueta: 'Tipo' },
  { clave: 'campo', etiqueta: 'Trabajo de campo', tipo: 'mono' },
  { clave: 'n', etiqueta: 'Muestra (n)', tipo: 'mono', alinear: 'der' },
  { clave: 'ambito', etiqueta: 'Ámbito' },
  { clave: 'eleccion', etiqueta: 'Elección' },
  { clave: 'pp', etiqueta: 'PP', tipo: 'mono', alinear: 'der' },
  { clave: 'psoe', etiqueta: 'PSOE', tipo: 'mono', alinear: 'der' },
  { clave: 'vox', etiqueta: 'VOX', tipo: 'mono', alinear: 'der' },
  { clave: 'sumar', etiqueta: 'Sumar', tipo: 'mono', alinear: 'der' },
  { clave: 'ficha', etiqueta: 'Ficha técnica' },
];

const partido = (e: (typeof encuestas)[number], p: string) => {
  const v = (e.partidos as unknown as Record<string, number>)[p];
  return v === undefined ? '—' : num(v, 1);
};

const filas: Fila[] = encuestas.map((e) => ({
  id: e.id,
  casa: e.casa ?? '—',
  tipo: e.tipo ?? '—',
  campo: campo(e.fecha_trabajo),
  n: e.n ? entero(e.n) : '—',
  ambito: ambito(e.ambito),
  eleccion: String(e.eleccion ?? '—'),
  pp: partido(e, 'PP'),
  psoe: partido(e, 'PSOE'),
  vox: partido(e, 'VOX'),
  sumar: partido(e, 'SUMAR'),
  ficha: e.url ? 'enlace' : '—',
}));

// Atributos de filtrado por fila (índices de dimensión), leídos por el CSS.
const filaAttrs: AtributosFila[] = encuestas.map((e) => ({
  'data-fila': '',
  'data-casa': idx(casas, e.casa),
  'data-anio': idx(anios, e.anio),
  'data-eleccion': idx(elecciones, String(e.eleccion)),
}));

// CSS de filtrado puro (sin JavaScript): `:has()` sobre el contenedor + `:not()`
// por fila. Cada dimensión activa esconde las filas que no casan; al combinarse
// varias reglas, el efecto es AND. Sin navegador con :has(), no filtra y se ven
// todas las filas: degradación honesta, nunca un resultado falso.
const reglas: string[] = [];
casas.forEach((_, i) => {
  if (i > 0) reglas.push(`.explorador:has(#fc-${i}:checked) [data-fila]:not([data-casa="${i}"]){display:none}`);
});
anios.forEach((_, i) => {
  if (i > 0) reglas.push(`.explorador:has(#fa-${i}:checked) [data-fila]:not([data-anio="${i}"]){display:none}`);
});
elecciones.forEach((_, i) => {
  if (i > 0) reglas.push(`.explorador:has(#fe-${i}:checked) [data-fila]:not([data-eleccion="${i}"]){display:none}`);
});
const cssFiltros = `<style>${reglas.join('')}</style>`;

const colsExclusiones: Columna[] = [
  { clave: 'id', etiqueta: 'ID encuesta', tipo: 'mono' },
  { clave: 'origen', etiqueta: 'Origen' },
  { clave: 'casa', etiqueta: 'Casa / estudio' },
  { clave: 'motivo', etiqueta: 'Motivo de exclusión' },
];
const filasExclusiones: Fila[] = exclusionesData.exclusiones.map((x) => ({
  id: x.id ?? '—',
  origen: x.origen === 'CIS' ? 'CIS' : 'Encuestadores',
  casa: x.casa ?? x.slug ?? '—',
  motivo: (x.motivo ?? '—').replace(/\s+/g, ' ').trim(),
}));
---

<Base
  titulo="Encuestas"
  descripcion="Explorador del histórico de encuestas electorales españolas: CIS y encuestadores privados, con ficha técnica y estado de validación."
>
  <div class="contenedor">
    <Breadcrumbs items={[{ label: 'Encuestas' }]} />

    <header class="cabecera-pagina">
      <p class="eyebrow entrada">Encuestas · 1977–2026</p>
      <h1 class="medida entrada entrada--1">Explorador de encuestas</h1>
      <p class="titular-intro entrada entrada--2">
        Intención de voto con muestra, fechas de campo y ficha técnica de origen.
      </p>
    </header>

    <Fragment set:html={cssFiltros} />

    <div class="explorador">
      <aside class="filtros" aria-labelledby="filtros-titulo">
        <h2 class="filtros__titulo" id="filtros-titulo">Filtros</h2>
        <p class="nota">
          Filtrado sin JavaScript (radios nativos + CSS). Si tu navegador no soporta
          <span class="mono">:has()</span>, se muestran todas las filas en lugar de un
          resultado falso.
        </p>

        <form>
          <fieldset class="campo filtro">
            <legend class="label">Casa encuestadora</legend>
            <div class="grupo-opciones">
              <label><input type="radio" name="casa" id="fc-0" checked /> Todas</label>
              {casas.map((c, i) => (
                <label><input type="radio" name="casa" id={`fc-${i + 1}`} /> {c}</label>
              ))}
            </div>
          </fieldset>

          <fieldset class="campo filtro">
            <legend class="label">Año (de campo/publicación)</legend>
            <div class="grupo-opciones grupo-opciones--compacto">
              <label><input type="radio" name="anio" id="fa-0" checked /> Todos</label>
              {anios.map((a, i) => (
                <label><input type="radio" name="anio" id={`fa-${i + 1}`} /> {a}</label>
              ))}
            </div>
          </fieldset>

          <fieldset class="campo filtro">
            <legend class="label">Elección / ámbito</legend>
            <div class="grupo-opciones">
              <label><input type="radio" name="eleccion" id="fe-0" checked /> Todas</label>
              {elecciones.map((e, i) => (
                <label><input type="radio" name="eleccion" id={`fe-${i + 1}`} /> {e}</label>
              ))}
            </div>
          </fieldset>
        </form>
      </aside>

      <div class="resultados">
        <p class="mono resultados__contador">
          N = {entero(encuestasData.meta.n)} encuestas · {entero(encuestasData.meta.n_cis)} del CIS ·
          {entero(encuestasData.meta.n_privados)} de privados · actualizado {fechaCorta('2026-10-15')}
        </p>
        <p class="nota">
          El contador no se recalcula al filtrar (no hay JavaScript en la página); las
          filas que no cumplen el filtro simplemente se ocultan.
        </p>

        <DataTable
          id="tabla-encuestas"
          titulo="Encuestas indexadas"
          columnas={cols}
          filas={filas}
          filaAttrs={filaAttrs}
          fuente={{ nombre: 'CIS y fichas técnicas de encuestadores privados', url: '/metodologia/' }}
          extraido="2026-10-15"
          vacio="No hay encuestas indexadas."
          nota={encuestasData.meta.nota_base}
        />

        <!-- Atributos de filtrado: cada fila lleva data-casa / data-anio / data-eleccion -->

        <section class="ficha-ejemplo" aria-labelledby="fichas-titulo">
          <h2 id="fichas-titulo">Fichas técnicas</h2>
          <p class="nota">
            Cada encuesta del catálogo con su ficha: muestra, fechas de campo, metodología
            y enlace obligatorio a la fuente publicada.
          </p>
          <details class="fichas">
            <summary>Ver las {entero(encuestas.length)} fichas técnicas</summary>
            <div class="fichas__lista">
              {encuestas.map((e) => (
                <SourceCard
                  id={e.id}
                  titulo={`${e.casa ?? '—'} · ${e.eleccion ?? '—'}`}
                  url={e.url ?? undefined}
                  estado={e.url ? 'verificada' : 'pendiente'}
                  campos={[
                    { clave: 'Trabajo de campo', valor: campo(e.fecha_trabajo) },
                    { clave: 'Publicación', valor: e.fecha_publicacion ? fechaCorta(e.fecha_publicacion) : '—' },
                    { clave: 'Muestra (n)', valor: e.n ? entero(e.n) : '—' },
                    { clave: 'Metodología', valor: e.metodologia ?? '—' },
                    { clave: 'Ámbito', valor: ambito(e.ambito) },
                    { clave: 'Base del %', valor: e.base === 'censo' ? 'sobre censo (microdato CIS)' : 'sobre voto válido' },
                  ]}
                />
              ))}
            </div>
          </details>
        </section>

        <section class="seccion--compacta" aria-labelledby="exclusiones-titulo">
          <h2 id="exclusiones-titulo">Log de exclusiones</h2>
          <p class="medida nota">
            Las encuestas que no pasaron validación, con su motivo. No desaparecen: se
            documentan. También está en la <a href="/metodologia/#exclusiones">metodología</a>.
          </p>
          <DataTable
            id="tabla-exclusiones"
            columnas={colsExclusiones}
            filas={filasExclusiones}
            vacio="No hay exclusiones registradas."
            nota={`${entero(exclusionesData.meta.n)} entradas (${entero(exclusionesData.meta.n_cis)} del CIS, ${entero(exclusionesData.meta.n_privados)} de encuestadores).`}
          />
        </section>

        <aside class="aviso-loreg" aria-labelledby="loreg-titulo">
          <p class="eyebrow" id="loreg-titulo">Norma aplicada</p>
          <p>
            <strong>Apagón electoral (LOREG).</strong> Los cinco días previos al 29N
            no se publicarán resultados de encuestas en esta sección. La restricción se
            aplica en la web, no en los datos: el histórico completo sigue disponible
            antes y después de esa ventana.
          </p>
        </aside>
      </div>
    </div>
  </div>
</Base>

<style>
  .cabecera-pagina { padding-block: var(--s-5) var(--s-6); }

  .explorador {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
    border-top: var(--borde-tinta);
    padding-top: var(--s-5);
  }

  .filtros { position: sticky; top: calc(var(--header-h) + var(--s-3)); }
  .filtros__titulo { font-family: var(--f-body); font-size: var(--t-h3); }
  .filtro { border: 0; padding: 0; margin-inline: 0; }
  .filtro legend { font-weight: 700; font-size: var(--t-small); margin-bottom: var(--s-1); padding: 0; }
  .grupo-opciones--compacto { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--s-2); }

  .resultados__contador { margin: 0 0 var(--s-1); color: var(--tinta-2); font-size: 0.8125rem; }

  .ficha-ejemplo { margin-top: var(--s-6); border-top: var(--borde-regla); padding-top: var(--s-4); }
  .ficha-ejemplo h2 { font-size: 1.3rem; }
  .fichas > summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; color: var(--enlace); }
  .fichas__lista { display: flex; flex-direction: column; gap: var(--s-3); margin-top: var(--s-3); }

  .aviso-loreg {
    margin-top: var(--s-6);
    background: var(--papel-2);
    border: var(--borde-regla);
    border-radius: var(--radio);
    padding: var(--s-4);
    max-width: 60ch;
    font-size: var(--t-small);
    line-height: var(--lh-small);
  }

  @media (max-width: 980px) {
    .explorador { grid-template-columns: 1fr; }
    .filtros { position: static; }
  }
</style>
